<!DOCTYPE html>
<html lang="en">

<head>
    <title>OpenLayers with Express & EJS - Optimized Route</title>
    <%-include('includes/head')%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Kanit';
        }

        #map {
            width: 60%;
            height: 100vh;
            z-index: 1;
        }

        .mapContainer {
            display: flex;
        }

        .statusBar {
            width: 40%;
            height: 100vh;
            /* position: absolute; */
            z-index: 2;
            display: flex;

            h1 {
                text-align: center;
                margin: 10px;
            }

            table {
                padding: 20px;

                td {
                    padding: 10px;
                }
            }

            .statusContainer {
                width: 100%;
                display: block;
                background: #fffffff4;

                .content {
                    max-height: 80vh;
                    overflow: auto;
                }
            }
        }

        @media screen and (max-width: 1200px) {
            .mapContainer {
                display: block;
            }

            #map {
                width: 100%;
                height: 60vh;
            }

            .statusBar {
                width: 100%;
                height: 100%;
                position: static;
                height: max-content;
            }
            
            .statusBar .statusContainer {
                width: 100%;
            }
            .statusBar .statusContainer .content {
                height: 20vh;
            }
        }
    </style>
</head>
<body>
    <div class="mapContainer">
        <div class="statusBar">
            <div class="statusContainer">
                <%-include('includes/nav')%>
                <h2 class="text-center mt-4">🚚 เส้นทางส่งสินค้า</h2>
                <ul class="px-4 pt-2 list-group">
                    <li class="list-group-item">ชื่อ: <%=auth.user.full_name%></li>
                    <li class="list-group-item">ทะเบียนรถ: <span id="license_plate">-</span></li>
                </ul>
                <div class="content">
                    <div class="p-4">
                        <table class="table">
                            <thead>
                                <th>ชื่อลูกค้า</th>
                                <th colspan="2" style="width: 40%;">จัดการ</th>
                            </thead>
                            <tbody id="statusBarBody">
            
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="map"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
    <script>
        let truck_id = "<%=truck_id%>"
        let driver_id = "<%=driver_id%>"
    </script>
    <script src="/js/location_tracker.js"></script>
    <script src="/js/driver.js"></script>
    <%-include('includes/footer')%>
</body>
</html>