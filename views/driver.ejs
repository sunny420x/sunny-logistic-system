<!DOCTYPE html>
<html lang="en">

<head>
    <title>Sunny's Logistic</title>
    <%-include('includes/head')%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Kanit';
        }
        #map {
            width: 60%;
            height: 100vh;
            z-index: 1;
        }
        .mapContainer {
            display: flex;
        }
        .statusBar {
            width: 40%;
            height: 100vh;
            z-index: 2;
            display: flex;

            h1 {
                text-align: center;
                margin: 10px;
            }
            .statusContainer {
                width: 100%;
                display: block;
                background: #fffffff4;

                .content {
                    max-height: 80vh;
                    overflow: auto;
                }
            }
            .statusContainer .content {
                padding: 20px;
            }
        }

        @media screen and (max-width: 1200px) {
            .mapContainer {
                display: block;
            }
            #map {
                width: 100%;
                height: calc(100vh - 190px);
            }
            .statusBar {
                width: 100%;
                height: 100%;
                position: static;
                height: max-content;
            }
            .statusBar .statusContainer {
                width: 100%;
            }
            .statusBar .statusContainer .content {
                padding: 0px;
                height: 130px;
            }
            #driverInfo,#pageTitle {
                display: none;
            }
            table {
                width: 100%;
                font-size: 14px;
                padding: 0;
                margin: 0;

                .btn {
                    width: 100%;
                    font-size: 14px;
                    margin-bottom: 5px;
                }
            }
        }
    </style>
</head>
<body>
    <div class="mapContainer">
        <div class="statusBar">
            <div class="statusContainer">
                <%-include('includes/nav')%>
                <h2 class="text-center mt-4" id="pageTitle">🚚 เส้นทางส่งสินค้า</h2>
                <ul class="px-4 pt-2 list-group" id="driverInfo">
                    <li class="list-group-item"><strong>ชื่อ:</strong> <%=auth.user.full_name%></li>
                    <li class="list-group-item"><strong>ทะเบียนรถ:</strong> <span id="license_plate">-</span></li>
                </ul>
                <div class="content">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <th>ชื่อลูกค้า</th>
                                <th style="width: 50%;">จัดการ</th>
                            </thead>
                            <tbody id="statusBarBody">
            
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="map"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
    <script src="/js/driver.js"></script>
    <script>
        driver_id = "<%=driver_id%>"
    </script>
    <script src="/js/location_tracker.js"></script>
    <%-include('includes/footer')%>
</body>
</html>