<!DOCTYPE html>
<html lang="th">

<head>
    <title>Driver Dashboard | <%=settings.company_name%></title>
    <%-include('includes/head')%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
    <style>
        :root {
            --page-bg: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --primary-color: #2563eb;
            --primary-light: #eff6ff;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: 'Kanit', system-ui, -apple-system, sans-serif;
            background-color: var(--page-bg);
            color: var(--text-primary);
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .driver-page-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        /* Navbar Custom Minimal Styling */
        .navbar {
            background: #ffffff !important;
            border-bottom: 1px solid var(--border-color);
            padding: 0.65rem 1.25rem;
            z-index: 1030;
            flex-shrink: 0;
        }
        .navbar-brand {
            color: var(--text-primary) !important;
            font-weight: 600;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .navbar-dark .navbar-nav .nav-link {
            color: var(--text-secondary) !important;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            transition: all 0.15s ease;
        }
        .navbar-dark .navbar-nav .nav-link:hover {
            color: var(--primary-color) !important;
            background: var(--primary-light);
        }
        .navbar-toggler {
            border-color: #cbd5e1 !important;
            padding: 4px 8px;
        }
        .navbar-toggler-icon {
            filter: invert(0.2);
        }

        /* Layout Split */
        .mapContainer {
            display: flex;
            flex: 1;
            height: calc(100vh - 58px);
            position: relative;
            overflow: hidden;
        }

        /* Side Status Panel */
        .statusBar {
            width: 420px;
            min-width: 360px;
            height: 100%;
            background: #ffffff;
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            z-index: 10;
            box-shadow: 4px 0 24px rgba(15, 23, 42, 0.03);
        }

        .statusContainer {
            display: flex;
            flex-direction: column;
            height: 100%;
            width: 100%;
            overflow: hidden;
        }

        .driver-header-card {
            padding: 1.25rem 1.25rem 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            background: #ffffff;
        }

        .driver-profile-info {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }

        .info-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: #f1f5f9;
            padding: 0.35rem 0.75rem;
            border-radius: 10px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            border: 1px solid #e2e8f0;
        }

        .info-pill i {
            color: var(--primary-color);
            font-size: 0.95rem;
        }

        /* Content & Table Area */
        .statusBar .content {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .table {
            margin: 0;
            border-color: #f1f5f9;
        }

        .table th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background-color: #f8fafc;
            border-bottom: 1px solid var(--border-color);
            padding: 0.65rem 0.75rem;
        }

        .table td {
            padding: 0.85rem 0.75rem;
            vertical-align: middle;
            font-size: 0.875rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .table tbody tr {
            transition: background-color 0.15s ease;
        }

        .table tbody tr:hover {
            background-color: #f8fafc;
        }

        /* Custom Table Buttons injected by JS */
        .table .btn {
            padding: 0.35rem 0.65rem;
            font-size: 0.8rem;
            border-radius: 8px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            transition: all 0.15s ease;
            margin-right: 2px;
            margin-bottom: 2px;
        }

        .table .btn-light {
            background-color: #f1f5f9;
            border: 1px solid #cbd5e1;
            color: #334155;
        }

        .table .btn-light:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

        .table .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #ffffff;
        }

        .table .btn-primary:hover {
            background-color: #1d4ed8;
        }

        /* Map Section */
        #mapWrapper {
            flex: 1;
            height: 100%;
            position: relative;
        }

        #map {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* Floating Re-center Button */
        button.setCenter {
            position: absolute;
            bottom: 24px;
            right: 24px;
            z-index: 20;
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-primary);
            font-size: 1.1rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        button.setCenter:hover {
            background: #f8fafc;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.16);
            color: var(--primary-color);
        }

        button.setCenter:active {
            transform: translateY(0);
        }

        /* Responsive Breakpoints */
        @media screen and (max-width: 991.98px) {
            .mapContainer {
                flex-direction: column;
                height: calc(100vh - 56px);
            }

            #mapWrapper {
                height: 42vh;
                min-height: 240px;
                width: 100%;
                flex: none;
                order: 1;
            }

            .statusBar {
                width: 100%;
                min-width: 100%;
                flex: 1;
                order: 2;
                border-right: none;
                border-top: 1px solid var(--border-color);
                box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.05);
            }

            .driver-header-card {
                padding: 0.75rem 1rem;
            }

            .driver-header-card h2 {
                font-size: 1rem !important;
            }

            .statusBar .content {
                padding: 0.5rem 0.75rem;
            }

            button.setCenter {
                bottom: 16px;
                right: 16px;
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="driver-page-wrapper">
        <%-include('includes/nav')%>
        
        <div class="mapContainer">
            <div class="statusBar">
                <div class="statusContainer">
                    <div class="driver-header-card">
                        <div class="d-flex align-items-center justify-content-between">
                            <h2 class="m-0 fw-bold fs-5 text-dark" id="pageTitle"><i class="bi bi-truck text-primary me-2"></i>เส้นทางส่งสินค้า</h2>
                            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">คิวประจำวันนี้</span>
                        </div>
                        <div class="driver-profile-info" id="driverInfo">
                            <div class="info-pill">
                                <i class="bi bi-person-circle"></i>
                                <span><strong>พนักงาน:</strong> <%=auth.user.full_name%></span>
                            </div>
                            <div class="info-pill">
                                <i class="bi bi-truck-front"></i>
                                <span><strong>ทะเบียนรถ:</strong> <span id="license_plate" class="fw-semibold text-primary">-</span></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="content">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;" class="text-center">รอบ</th>
                                        <th>รายละเอียดลูกค้า</th>
                                        <th style="width: 140px;" class="text-end">จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody id="statusBarBody">
                                    <!-- Dynamic content rendered by driver.js -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

                    <script>
                    async function uploadArrivalImage(route_id) {
                        const { value: files } = await Swal.fire({
                            title: 'อัพโหลดรูปหลักฐานการส่งของ',
                            input: 'file',
                            inputAttributes: {
                                'accept': 'image/*',
                                'multiple': 'multiple',
                                'aria-label': 'Upload arrival images'
                            },
                            showCancelButton: true,
                            confirmButtonText: 'อัพโหลดเลย!',
                            cancelButtonText: 'ยกเลิก'
                        });

                        const selectedFiles = Array.from(files || []);

                        if (selectedFiles.length > 0) {
                            const formData = new FormData();
                            selectedFiles.forEach((file) => {
                                formData.append('files', file);
                            });
                            formData.append('route_id', route_id)

                            Swal.fire({
                                title: 'กำลังอัพโหลด...',
                                didOpen: () => { Swal.showLoading(); }
                            });

                            try {
                                const response = await fetch(`/api/driver/uploadArrivalImage/`, {
                                    method: 'POST',
                                    body: formData
                                });

                                if (response.ok) {
                                    Swal.fire('สำเร็จ!', 'อัพโหลดหลักฐานการส่งสินค้าเรียบร้อยแล้ว', 'success');
                                    finishDelivery(route_id)
                                } else {
                                    Swal.fire('เกิดข้อผิดพลาด!', 'เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์', 'error');
                                }
                            } catch (error) {
                                Swal.fire('เกิดข้อผิดพลาด!', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                            }
                        }
                    }

                    function setCenter() {
                        const currentLonLat = [parseFloat(position_longitude), parseFloat(position_latitude)];
                        const currentCoordinate = ol.proj.fromLonLat(currentLonLat);
                        const view = map.getView();
                        const routeFeature = vectorSource?.getFeatureById('current-route');
                        const routeCoordinates = routeFeature?.getGeometry()?.getCoordinates() || [];

                        if (routeCoordinates.length < 2) {
                            view.animate({ center: currentCoordinate, rotation: 0, duration: 1000 });
                            return;
                        }

                        const currentRouteIndex = routeCoordinates.reduce((closestIndex, coordinate, index) => {
                            const closestDistance = Math.hypot(
                                routeCoordinates[closestIndex][0] - currentCoordinate[0],
                                routeCoordinates[closestIndex][1] - currentCoordinate[1]
                            );
                            const distance = Math.hypot(
                                coordinate[0] - currentCoordinate[0],
                                coordinate[1] - currentCoordinate[1]
                            );
                            return distance < closestDistance ? index : closestIndex;
                        }, 0);
                        const nextCoordinate = routeCoordinates[Math.min(currentRouteIndex + 1, routeCoordinates.length - 1)];
                        const currentLonLatOnRoute = ol.proj.toLonLat(currentCoordinate);
                        const nextLonLat = ol.proj.toLonLat(nextCoordinate);
                        const bearing = Math.atan2(
                            Math.sin((nextLonLat[0] - currentLonLatOnRoute[0]) * Math.PI / 180) * Math.cos(nextLonLat[1] * Math.PI / 180),
                            Math.cos(currentLonLatOnRoute[1] * Math.PI / 180) * Math.sin(nextLonLat[1] * Math.PI / 180) -
                            Math.sin(currentLonLatOnRoute[1] * Math.PI / 180) * Math.cos(nextLonLat[1] * Math.PI / 180) *
                            Math.cos((nextLonLat[0] - currentLonLatOnRoute[0]) * Math.PI / 180)
                        );
                        const distanceToNext = Math.hypot(
                            nextCoordinate[0] - currentCoordinate[0],
                            nextCoordinate[1] - currentCoordinate[1]
                        );
                        const lookAheadDistance = Math.min(80, distanceToNext / 2);
                        const lookAheadRatio = distanceToNext > 0 ? lookAheadDistance / distanceToNext : 0;
                        const lookAheadCoordinate = [
                            currentCoordinate[0] + (nextCoordinate[0] - currentCoordinate[0]) * lookAheadRatio,
                            currentCoordinate[1] + (nextCoordinate[1] - currentCoordinate[1]) * lookAheadRatio
                        ];

                        view.animate({
                            center: lookAheadCoordinate,
                            rotation: -bearing,
                            duration: 1000
                        });
                    }
                    </script>
                </div>
            </div>

            <div id="mapWrapper">
                <div id="map"></div>
                <button class="setCenter" onclick="setCenter()" title="จัดกึ่งกลางตำแหน่ง"><i class="bi bi-crosshair"></i></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
    <script src="/js/driver.js"></script>
    <script>
        driver_id = "<%=auth.user.id%>"
    </script>
    <script src="/js/location_tracker.js"></script>
    <%-include('includes/footer')%>
</body>
</html>