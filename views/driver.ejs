<!DOCTYPE html>
<html lang="en">

<head>
    <title>Driver Dashboard | <%=settings.company_name%></title>
    <%-include('includes/head')%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Kanit';
        }
        #map {
            width: 60%;
            height: 100vh;
            z-index: 1;
        }
        .mapContainer {
            display: flex;
        }
        .statusBar {
            width: 40%;
            height: 100vh;
            z-index: 2;
            display: flex;

            h1 {
                text-align: center;
                margin: 10px;
            }
            .statusContainer {
                width: 100%;
                display: block;
                background: #fffffff4;

                .content {
                    max-height: 80vh;
                    overflow: auto;
                }
            }
            .statusContainer .content {
                padding: 20px;
            }
        }

        @media screen and (max-width: 1200px) {
            .mapContainer {
                display: block;
            }
            #map {
                width: 100%;
                height: calc(90vh - 190px);
            }
            .statusBar {
                width: 100%;
                height: 100%;
                position: static;
                height: max-content;
            }
            .statusBar .statusContainer {
                width: 100%;
            }
            .statusBar .statusContainer .content {
                padding: 0px;
                height: 130px;
            }
            #driverInfo,#pageTitle {
                display: none;
            }
            table {
                width: 100%;
                font-size: 14px;
                padding: 0;
                margin: 0;

                .btn {
                    width: 100%;
                    font-size: 14px;
                    margin-bottom: 5px;
                }
            }
        }
    </style>
</head>
<body>
    <div class="mapContainer">
        <div class="statusBar">
            <div class="statusContainer">
                <%-include('includes/nav')%>
                <h2 class="text-center mt-4" id="pageTitle">🚚 เส้นทางส่งสินค้า</h2>
                <ul class="px-4 pt-2 list-group" id="driverInfo">
                    <li class="list-group-item"><strong>ชื่อ:</strong> <%=auth.user.full_name%></li>
                    <li class="list-group-item"><strong>ทะเบียนรถ:</strong> <span id="license_plate">-</span></li>
                </ul>
                <div class="content">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <th>ชื่อลูกค้า</th>
                                <th style="width: 50%;">จัดการ</th>
                            </thead>
                            <tbody id="statusBarBody">
            
                            </tbody>
                        </table>
                    </div>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

                <script>
                async function uploadArrivalImage(route_id) {
                    const { value: files } = await Swal.fire({
                        title: 'อัพโหลดรูปหลักฐานการส่งของ',
                        input: 'file',
                        inputAttributes: {
                            'accept': 'image/*',
                            'multiple': 'multiple',
                            'aria-label': 'Upload arrival images'
                        },
                        showCancelButton: true,
                        confirmButtonText: 'อัพโหลดเลย!',
                        cancelButtonText: 'อาจจะยังน้า...'
                    });

                    const selectedFiles = Array.from(files || []);

                    if (selectedFiles.length > 0) {
                        const formData = new FormData();
                        selectedFiles.forEach((file) => {
                            formData.append('files', file);
                        });
                        formData.append('route_id', route_id)

                        Swal.fire({
                            title: 'Uploading...',
                            didOpen: () => { Swal.showLoading(); }
                        });

                        try {
                            const response = await fetch(`/api/driver/uploadArrivalImage/`, {
                                method: 'POST',
                                body: formData
                            });

                            if (response.ok) {
                                Swal.fire('สำเร็จ!', 'อัพโหลดหลักฐานการส่งสินค้าเรียบร้อยแล้ว', 'success');
                                finishDelivery(route_id)
                            } else {
                                Swal.fire('เอ๊ะ!', 'เกิดข้อผิดพลาดในการติดต่อเซิร์ฟเวอร์', 'error');
                            }
                        } catch (error) {
                            Swal.fire('เอ๊ะ!', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        }
                    }
                }
                </script>

            </div>
        </div>
        <div id="map"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
    <script src="/js/driver.js"></script>
    <script>
        driver_id = "<%=auth.user.id%>"
    </script>
    <script src="/js/location_tracker.js"></script>
    <%-include('includes/footer')%>
</body>
</html>