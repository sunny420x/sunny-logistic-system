<!doctype html>
<html lang="th">
<head>
  <title>Trucks</title>
  <%-include('includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <!-- Topbar -->
    <%-include('includes/topbar')%>

    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">🚚 รถบรรทุกในระบบ <button class="btn btn-outline-primary" onclick="window.location.href='/admin/trucks/add'">➕ เพิ่มรถในระบบ</button></h2>
      <table class="table">
        <thead>
          <th>#</th>
          <th>ทะเบียนรถ</th>
          <th>พิกัดที่อยู่</th>
          <th>จัดการ</th>
        </thead>
        <tbody>
          <% trucks.forEach(row => { %>
          <tr>
            <td><%=row.id%></td>
            <td><%=row.license_plate%></td>
            <td><%=row.location ?? "-"%></td>
            <td><button class="btn btn-outline-primary" onclick="window.location.href='/admin/trucks/edit/<%=row.id%>'">แก้ไข</button></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>

  <%-include('includes/footer')%>
</body>
</html>
