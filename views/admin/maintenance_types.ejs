<!doctype html>
<html lang="th">
<head>
  <title>ประเภทการบำรุงรักษารถ | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex">
                <h2 class="fw-bold mb-3">ประเภทการบำรุงรักษารถ
                    <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/maintenances/types/add'"><i class="bi bi-file-earmark-plus"></i> เพิ่มประเภท</button>
                </h2>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 200px;">วันที่</th>
                    <th>ประเภท</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody id="maintenanceTypesTableBody"><tr class="skeleton-row" aria-hidden="true"><td colspan="3"><span class="skeleton-line"></span></td></tr></tbody>
        </table>
        <div id="maintenanceTypesPagination" class="mt-3"></div>
    </main>
  </div>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
    <script>
        const maintenanceTypesTable = AdminServerPagination({
            resource: 'maintenance_types', tableBody: 'maintenanceTypesTableBody', pagination: 'maintenanceTypesPagination', colspan: 3,
            getFilters: () => ({}),
            renderRow: row => `<tr><td>${moment(row.created_at).format('DD/MM/YYYY HH:mm:ss')}</td><td>${row.name}</td><td><button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/maintenances/types/edit/${row.id}'"><i class="bi bi-pencil-square"></i> แก้ไข</button> <button class="btn btn-outline-danger btn-sm" onclick="deleteMaintenanceType(${row.id})"><i class="bi bi-trash3"></i> ลบ</button></td></tr>`
        });
        maintenanceTypesTable.load();

        function deleteMaintenanceType(id) {
            Swal.fire({ title: 'คุณแน่ใจหรือไม่?', text: 'คุณต้องการลบประเภทการบำรุงรักษานี้ออกจากระบบ', icon: 'warning', showCancelButton: true, confirmButtonText: 'ใช่, ลบเลย!', cancelButtonText: 'ยกเลิก' }).then(result => {
                if (result.isConfirmed) window.location.href = `/admin/maintenances/types/delete/${id}`;
            });
        }
    </script>
  <%-include('includes/footer')%>
</body>
</html>
