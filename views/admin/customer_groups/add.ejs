<!doctype html>
<html lang="th">
<head>
  <title>เพิ่มกลุ่มลูกค้า | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">


    <main class="container-fluid p-3 p-lg-4">
      <div class="mb-4">
        <div>
          <h2 class="fw-bold mb-3">เพิ่มลูกค้าในระบบ</h2>
          <form action="" method="post" style="width: 800px;">
            <div class="form-group mb-3">
                <label for="customer_name">ชื่อกลุ่ม: </label>
                <input type="text" name="customer_group_name" class="form-control" required>
            </div>
            <div class="form-group mb-3">
                <label for="color" class="form-label">สีที่ใช้แสดงผล</label>
                <input type="color" class="form-control form-control-color" id="color" name="customer_group_color" value="<%=user_type.color%>" title="เลือกสี">
            </div>
            <input type="submit" value="เพิ่มกลุ่มลูกค้า" class="btn btn-primary w-100">
          </form>
        </div>
      </div>
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
