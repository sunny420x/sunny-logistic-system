<!doctype html>
<html lang="th">
<head>
  <title>แก้ไขข้อมูลกลุ่มลูกค้า | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">


    <main class="container-fluid p-3 p-lg-4">
      <div class="mb-4">
        <div>
          <h2 class="fw-bold mb-3">แก้ไขกลุ่มลูกค้าในระบบ</h2>
          <form action="" method="post" style="width: 800px;">
            <div class="form-group mb-3">
                <label for="customer_name">ชื่อกลุ่ม: </label>
                <input type="text" name="name" class="form-control" value="<%=customer_group.name%>" required>
            </div>
            <div class="form-group mb-3">
                <label for="color" class="form-label">สีที่ใช้แสดงผล</label>
                <input type="color" class="form-control form-control-color w-100" id="color" name="color" value="<%=customer_group.color%>" title="เลือกสี">
            </div>

            <p><strong>เพิ่มโดย:</strong> <%=customer_group.created_by_user ?? "-" %><br>
            <strong>เมื่อ:</strong> <% if(customer_group.created_at) { %><%=moment(customer_group.created_at).format("DD/MM/YYYY HH:mm:ss") %><%} else {%>-<%} %></p>

            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-floppy me-2"></i>บันทึกการเปลี่ยนแปลง</button>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
