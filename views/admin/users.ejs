<!doctype html>
<html lang="th">
<head>
  <title>ผู้ใช้งานระบบ | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-lg-flex gap-2">
      <h2 class="fw-bold mb-3">ผู้ใช้งานระบบ
      </h2>
      <button class="btn btn-outline-primary mb-2" onclick="window.location.href='/admin/users/add'"><i class="bi bi-person-plus"></i> เพิ่มผู้ใช้งานระบบ</button>
      <button class="btn btn-outline-secondary mb-2" onclick="window.location.href='/admin/user_types'"><i class="bi bi-person"></i> จัดการประเภทผู้ใช้งาน</button>
      <button class="btn btn-outline-secondary mb-2" onclick="window.location.href='/admin/calculate_round'"><i class="bi bi-cash-stack"></i> คิดค่ารอบ</button>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <th style="width: 40px;">#</th>
            <th style="width: 100px;">ชื่อผู้ใช้</th>
            <th style="width: 250px;">ชื่อเต็ม</th>
            <th style="width: 80px;">ประเภท</th>
            <th style="width: 150px;">โทรศัพท์</th>
            <th style="width: 200px;">จัดการ</th>
          </thead>
          <tbody id="usersTableBody"><tr><td colspan="6" class="text-muted text-center">กำลังโหลดข้อมูล...</td></tr></tbody>
        </table>
      </div>
      <div id="usersPagination" class="mt-3"></div>
    </main>
  </div>

  <script>
    const usersTable = AdminServerPagination({
      resource: 'users', tableBody: 'usersTableBody', pagination: 'usersPagination', colspan: 6,
      getFilters: () => ({ q: new URLSearchParams(window.location.search).get('q') }),
      renderRow: row => `<tr><td>${row.id}</td><td>${row.username}</td><td>${row.full_name || '-'}</td><td><div class="badge bg-${row.user_type_color || 'secondary'} fw-normal">${row.user_type}</div></td><td>${row.phone_number || '-'}</td><td><button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/users/edit/${row.id}'"><i class="bi bi-pencil-square"></i> แก้ไข</button> <button class="btn btn-outline-danger btn-sm" onclick="deleteUser(${row.id})"><i class="bi bi-trash3"></i> ลบ</button></td></tr>`
    });
    usersTable.load();
    function deleteUser(id) { Swal.fire({ title: 'คุณแน่ใจหรือไม่?', text: 'คุณต้องการลบผู้ใช้งานรายนี้ออกจากระบบ', icon: 'warning', showCancelButton: true, confirmButtonText: 'ใช่, ลบเลย!', cancelButtonText: 'ยกเลิก' }).then(result => { if (result.isConfirmed) window.location.href = `/admin/users/delete/${id}`; }); }
  </script>

  <%-include('includes/footer')%>
</body>
</html>
