<!doctype html>
<html lang="th">
<head>
  <title>เพิ่มลูกค้า | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">


    <main class="container-fluid p-3 p-lg-4">
      <div class="mb-4">
        <div>
          <h2 class="fw-bold mb-3">เพิ่มลูกค้าในระบบ</h2>
          <form action="" method="post" style="width: 800px;">
            <div class="form-group mb-3">
                <label for="customer_name">ชื่อลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_name" class="form-control" required>
            </div>
            <div class="form-group mb-3">
                <label for="customer_id">รหัสลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_id" class="form-control" value="-" required>
            </div>

            <div class="form-group mb-3">
              <label for="group_id">กลุ่มลูกค้า:</label>
              <select name="group_id" class="form-select" required>
                  <% customer_groups.forEach(group => { %>
                    <option value="<%=group.id%>"><%=group.name%></option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group mb-3">
                <label for="address">ที่อยู่: </label>
                <input type="text" name="address" class="form-control" required>
            </div>

            <div class="form-group mb-3">
              พิกัดที่อยู่จาก Google Map: <input class="form-control" type="text" id="googleMapUrl" onkeyup="googleMapExtract()" placeholder="https://www.google.com/maps/place/...">
            </div>

            <div class="form-group mb-3">                
                <label for="location">พิกัดที่อยู่:</label>
                <input type="text" name="location" class="form-control" oninput="validateLocation()" required>
                <small>รูปแบบ: Longtitude,Latitude</small>
            </div>

            <input type="submit" value="เพิ่มลูกค้า" class="btn btn-primary w-100">
          </form>
        </div>
      </div>
      <script>
        function googleMapExtract() {
          const url = document.getElementById('googleMapUrl').value
          const regex = /@(-?\d+\.\d+),(-?\d+\.\d+)/
          const match = url.match(regex)
          if (match) {
            const latitude = match[1]
            const longitude = match[2]
            document.querySelector('input[name="location"]').value = `${longitude},${latitude}`
          } else {
            document.querySelector('input[name="location"]').value = ''
          }
        }

        function validateLocation() {
          const locationInput = document.querySelector('input[name="location"]')
          const locationValue = locationInput.value.trim()
          if (locationValue.split(',')[0] < 90) {
            locationInput.value = `${locationValue.split(',')[1]},${locationValue.split(',')[0]}`
          }
        }
      </script>
      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
