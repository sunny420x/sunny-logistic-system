<!doctype html>
<html lang="th">
<head>
  <title>เพิ่มลูกค้า | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 50%;
      height: 80vh;
      z-index: 1;
      overflow: hidden;
    }
    #customerInfo {
      width: 50%;
    }

    @media screen and (max-width: 1024px) {
      #map {
        width: 100%;
        height: 40vh;
      }
      #customerInfo {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <%-include('../includes/topbar')%>
  <%-include('../includes/desktop-sidebar')%>
  <%-include('../includes/mobile-sidebar')%>
  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div id="map"></div>
        <div id="customerInfo">
          <h2 class="fw-bold mb-3">เพิ่มลูกค้าในระบบ</h2>
          <p class="small">เพิ่มข้อมูลลูกค้าในระบบ เช่น ชื่อลูกค้า รหัสลูกค้าในระบบ Express กลุ่มลูกค้า และตำแหน่งที่อยู่</p>
          <form action="" method="post">
            <div class="form-group mb-3">
                <label for="customer_name">ชื่อลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_name" class="form-control" required>
            </div>
            <div class="form-group mb-3">
                <label for="customer_id">รหัสลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_id" class="form-control" value="-" required>
            </div>

            <div class="form-group mb-3">
              <label for="group_id">กลุ่มลูกค้า:</label>
              <select name="group_id" class="form-select" required>
                  <% customer_groups.forEach(group => { %>
                    <option value="<%=group.id%>"><%=group.name%></option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group mb-3">
                <label for="address">ที่อยู่: </label>
                <input type="text" name="address" class="form-control" required>
            </div>

            <div class="form-group mb-3">                
                <label for="location">พิกัดที่อยู่:</label>
                <input type="text" name="location" class="form-control" onblur="validateLocation()" required>
                <small>รูปแบบ: Longtitude,Latitude</small>
            </div>

            <input type="submit" value="เพิ่มลูกค้า" class="btn btn-primary w-100">
          </form>
        </div>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
      <script src="/js/admin/map.js"></script>
      <script>
        initializeMap();
      </script>
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
