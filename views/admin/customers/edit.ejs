<!doctype html>
<html lang="th">
<head>
  <title>แก้ไขข้อมูลลูกค้า | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 50%;
      height: 80vh;
      z-index: 1;
      overflow: hidden;
    }
    #customerInfo {
      width: 50%;
    }

    @media screen and (max-width: 1024px) {
      #map {
        width: 100%;
        height: 40vh;
      }
      #customerInfo {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div id="map"></div>
        <div id="customerInfo">
          <h2 class="fw-bold mb-3">แก้ไขข้อมูลลูกค้าในระบบ</h2>
          <p class="small">แก้ไขข้อมูลลูกค้าในระบบ เช่น ชื่อลูกค้า รหัสลูกค้าในระบบ Express กลุ่มลูกค้า และตำแหน่งที่อยู่</p>
          <form action="" method="post">
            <div class="form-group mb-3">
                <label for="customer_name">ชื่อลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_name" class="form-control" value="<%=customer.customer_name%>" required>
            </div>
            <div class="form-group mb-3">
                <label for="customer_id">รหัสลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_id" class="form-control" value="<%=customer.customer_id%>" required>
            </div>

            <div class="form-group mb-3">
              <label for="group_id">กลุ่มลูกค้า:</label>
              <select name="group_id" class="form-select" required>
                  <% customer_groups.forEach(group => { %>
                    <option value="<%=group.id%>" <% if(customer.group_id == group.id) { %>selected<%}%>><%=group.name%></option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group mb-3">
                <label for="address">ที่อยู่: </label>
                <input type="text" name="address" class="form-control" value="<%=customer.address%>" required>
            </div>

            <div class="form-group mb-3">                
                <label for="location">พิกัดที่อยู่: </label>
                <input type="text" name="location" class="form-control" value="<%=customer.location%>" onblur="setLocation()" required>
                <small>รูปแบบ: Longtitude,Latitude</small>
            </div>

            <div class="form-group mb-3">
                <label for="address">เบอร์โทรศัพท์: </label>
                <input type="text" name="phone_number" class="form-control" value="<%=customer.phone_number%>">
            </div>

            <input type="submit" value="บันทึกการเปลี่ยนแปลง" class="btn btn-primary w-100">
          </form>
        </div>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
      <script src="/js/admin/map.js"></script>
      <script>
        initializeMap();

        function setLocation() {
          validateLocation()
          setMarkOnMap(this.value.split(',')[0], this.value.split(',')[1])
        }
      </script>
      <!-- Set Mark On Map -->
      <% if (customer && customer.location && customer.location.includes(',')) { %>
      <script>
        setMarkOnMap("<%= customer.location.split(',')[0].trim() %>", "<%= customer.location.split(',')[1].trim() %>");
      </script>
      <% } %>
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
