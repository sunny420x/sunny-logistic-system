<!doctype html>
<html lang="th">
<head>
  <title>แก้ไขข้อมูลลูกค้า | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">


    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-3">แก้ไขข้อมูลลูกค้าในระบบ</h2>
          <form action="" method="post" style="width: 800px;">
            <div class="form-group mb-3">
                <label for="customer_name">ชื่อลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_name" class="form-control" value="<%=customer.customer_name%>" required>
            </div>
            <div class="form-group mb-3">
                <label for="customer_id">รหัสลูกค้าที่แสดงในระบบ: </label>
                <input type="text" name="customer_id" class="form-control" value="<%=customer.customer_id%>" required>
            </div>

            <div class="form-group mb-3">
              <label for="group_id">กลุ่มลูกค้า:</label>
              <select name="group_id" class="form-select" required>
                  <% customer_groups.forEach(group => { %>
                    <option value="<%=group.id%>" <% if(customer.group_id == group.id) { %>selected<%}%>><%=group.name%></option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group mb-3">
                <label for="address">ที่อยู่: </label>
                <input type="text" name="address" class="form-control" value="<%=customer.address%>" required>
            </div>

            <div class="form-group mb-3">                
                <label for="location">พิกัดที่อยู่: </label>
                <input type="text" name="location" class="form-control" value="<%=customer.location%>" required>
                <small>รูปแบบ: Longtitude,Latitude</small>
            </div>

            <input type="submit" value="บันทึกการเปลี่ยนแปลง" class="btn btn-primary w-100">
          </form>
        </div>
      </div>

      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
