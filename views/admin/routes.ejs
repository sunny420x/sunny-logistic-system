<!doctype html>
<html lang="th">
<head>
  <title>คิวส่งของ | <%=settings.company_name%></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <%-include('includes/head')%>
  <style>
    #map {
      width: 100%;
      height: 50vh;
      z-index: 1;
      overflow: hidden;
    }

    #poiListWrapper {
      height: 50vh;
      overflow: auto;
      border-radius: 0;
    }
  </style>
</head>
<body>
  <%-include('includes/topbar')%>
  <%-include('includes/desktop-sidebar')%>
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">คิวส่งของ 
        <button class="btn btn-outline-primary" type="button" onclick="window.location.href='/admin/routes/calendar'"><i class="bi bi-calendar"></i> แสดงปฏิทิน</button>
        <button class="btn btn-outline-primary" type="button" id="getTodayRouteBtn"><i class="bi bi-calendar"></i> แสดงคิววันนี้</button>
        <button class="btn btn-outline-primary" type="button" onclick="window.location.href='/admin/routes/add'"><i class="bi bi-calendar-plus"></i> เพิ่มคิวส่งของ</button>
        <button id="togglePoiButton" class="btn btn-outline-success" type="button"><i class="bi bi-people"></i> <span id="togglePoiText"></span></button>
      </h2>
      <div class="d-lg-flex flex-md-row gap-2 mb-4">
        <form action="" method="get" class="d-flex gap-2">
          <div class="d-lg-flex w-100 gap-2">
            <div class="input-group" style="min-width: 300px;">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input class="form-control bg-light" name="q" id="topbarSearch" type="search" placeholder="ค้นหา...">
            </div>
            <input type="date" class="form-control w-100" name="date" id="dateSearch" value="" style="min-width: 200px;">
            <select name="status" id="statusSearch" class="form-select w-100" style="min-width: 200px;">
              <option value="">เลือกสถานะ</option>
              <option value="0">มอบหมายแล้ว</option>
              <option value="1">ส่งแล้ว</option>
            </select>
            <button class="btn btn-primary w-100 mt-2 mt-lg-0" id="filterBtn"><i class="bi bi-filter"></i> กรอง</button>
          </div>
        </form>
        <button class="btn btn-secondary" id="clearFilterBtn" onclick="clearFilters()"><i class="bi bi-x"></i> ล้างตัวกรอง</button>
        <script>
          function getSearchQuery() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('q') ?? "";
          }
          
          function getStatusQuery() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('status') ?? "";
          }
          
          function getDateQuery() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('date') ?? "";
          }
          
          document.getElementById('topbarSearch').value = getSearchQuery() ?? ''
          document.getElementById('dateSearch').value = getDateQuery() ?? ''
          document.getElementById('statusSearch').value = getStatusQuery() ?? ''
        </script>
      </div>
      <div class="row g-0 gap-0">
        <div class="col-lg loading-surface" id="map"></div>
        <div class="col-lg-4 table-responsive" id="poiListWrapper">
          <table class="table">
            <thead>
              <th colspan="2">ลูกค้า</th>
              <th>โทรศัพท์</th>
            </thead>
            <tbody id="poiList"><tr class="skeleton-row" aria-hidden="true"><td><span class="skeleton-line short"></span></td><td><span class="skeleton-line"></span></td><td><span class="skeleton-line short"></span></td></tr><tr class="skeleton-row" aria-hidden="true"><td><span class="skeleton-line short"></span></td><td><span class="skeleton-line"></span></td><td><span class="skeleton-line short"></span></td></tr></tbody>
          </table>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table text-center">
          <thead>
            <th>#</th>
            <th>วันที่</th>
            <th>รอบ</th>
            <th>รหัสลูกค้า</th>
            <th>ชื่อลูกค้า</th>
            <th>สถานะ</th>
            <th>ทะเบียนรถ</th>
            <th>พนักงานปฏิบัติการ</th>
            <th>พิกัด</th>
            <th>เสร็จสิ้นเมื่อเวลา</th>
            <th>จัดการ</th>
          </thead>
          <tbody id="routesTableBody">
            <tr class="skeleton-row" aria-hidden="true"><td colspan="11"><span class="skeleton-line"></span></td></tr>
          </tbody>
        </table>
      </div>
      <div id="routesPagination" class="mt-3"></div>
    </main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js" integrity="sha512-hUhvpC5f8cgc04OZb55j0KNGh4eh7dLxd/dPSJ5VyzqDWxsayYbojWyl5Tkcgrmb/RVKCRJI1jNlRbVP4WWC4w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="/js/admin/map.js"></script>
  <script>
    let search = getSearchQuery()
    let date = getDateQuery()
    let status = getStatusQuery()

    let display_poi = false;
    let poi_list = []
    document.getElementById('poiListWrapper').style.display = display_poi ? "block" : "none"

    async function toggleDisplayPOI() {
      display_poi = !display_poi
      document.getElementById('poiListWrapper').style.display = display_poi ? "block" : "none"
      initializePOI()
      if (display_poi) {
        poi_list = []
      }
      try {
        await updateMap('route')
      } catch (error) {
        console.error('toggleDisplayPOI error', error)
        const poiListElem = document.getElementById('poiList')
        if (poiListElem) {
          poiListElem.innerHTML = `<tr><td colspan="3">เกิดข้อผิดพลาดในการโหลด POI</td></tr>`
        }
      }
    }

    function initializePOI() {
      if(!display_poi) {
        document.getElementById('togglePoiText').textContent = "แสดง Point of Interest (POI)"
      } else {
        document.getElementById('togglePoiText').textContent = "ซ่อน Point of Interest (POI)"
        const poiListElem = document.getElementById('poiList')
        if (poiListElem) {
          poiListElem.innerHTML = `<tr class="skeleton-row" aria-hidden="true"><td><span class="skeleton-line short"></span></td><td><span class="skeleton-line"></span></td><td><span class="skeleton-line short"></span></td></tr><tr class="skeleton-row" aria-hidden="true"><td><span class="skeleton-line short"></span></td><td><span class="skeleton-line"></span></td><td><span class="skeleton-line short"></span></td></tr>`
        }
      }
    }

    function renderPoiList() {
        const poiListElem = document.getElementById('poiList');
        if (!poiListElem) {
          console.error("[!] #poiList element not found!")
          return;
        }
        poiListElem.innerHTML = ""
        if (poi_list.length === 0) {
          poiListElem.innerHTML = `<tr><td colspan="3">ไม่มี Point of Interest</td></tr>`
          return;
        }
        let html = ''
        poi_list.forEach((poi) => {
          html += `
          <tr>
            <td>${poi.customer_id}</td>
            <td><a href="/admin/customers/edit/${poi.id}" target="_blank">${poi.customer_name}</a></td>
            <td>${formatPhoneNumber(poi.phone_number ?? "-")}</td>
          </tr>`
        })
        poiListElem.innerHTML = html
    }

    document.getElementById('togglePoiButton').addEventListener('click', async function() {
      await toggleDisplayPOI();
    });

    //โชว์คิวของวันนี้
    document.getElementById('getTodayRouteBtn').addEventListener('click', function() {
      document.getElementById('dateSearch').value = "<%=moment().format('YYYY-MM-DD')%>"
      document.getElementById('filterBtn').click()
    })

    async function initialize() {
      await initializeMap()
      document.getElementById('map').classList.add('is-loaded')
      initializePOI()
      await updateMap('route')
      await drawStartingPoint()
    }

    initialize()

    const routesTable = AdminServerPagination({
      resource: 'routes',
      tableBody: 'routesTableBody',
      pagination: 'routesPagination',
      colspan: 11,
      getFilters: () => ({ q: search, date, status }),
      renderRow: row => {
        const location = (row.location || '').split(',');
        const mapUrl = location.length === 2 ? `https://map.google.co.th/?q=${location[1]},${location[0]}` : '#';
        return `<tr>
          <td>${row.id}</td>
          <td>${moment(row.date).format('DD/MM/YYYY')}</td>
          <td>${row.round ?? '-'}</td>
          <td>${row.customer_id ?? '-'}</td>
          <td>${row.customer_name ?? '-'}</td>
          <td>${row.status ? '<span class="badge bg-success fw-normal">ส่งแล้ว</span>' : '<span class="badge bg-primary fw-normal">มอบหมายแล้ว</span>'}</td>
          <td>${row.truck_id ? `<a href="/admin/trucks/edit/${row.truck_id}" class="badge bg-secondary fw-normal" style="text-decoration: none;">${row.license_plate}</a>` : '<span class="badge bg-warning">ยังไม่ได้กำหนด</span>'}</td>
          <td>${row.driver_id ? `<a href="/admin/users/edit/${row.driver_id}" class="badge bg-secondary fw-normal" style="text-decoration: none;">${row.driver_full_name}</a>` : '<span class="badge bg-warning">ยังไม่ได้กำหนด</span>'}</td>
          <td><a href="${mapUrl}" class="text-decoration-none" target="_blank">Map</a></td>
          <td>${row.finish_at ? moment(row.finish_at).format('DD/MM/YYYY HH:mm') : '-'}</td>
          <td><div class="d-block d-lg-flex gap-2"><button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/routes/edit/${row.id}'"><i class="bi bi-pencil-square"></i></button><button class="btn btn-outline-danger btn-sm" onclick="deleteRoute(${row.id})"><i class="bi bi-trash3"></i></button></div></td>
        </tr>`;
      }
    });
    routesTable.load();

    function deleteRoute(id) {
      Swal.fire({ title: 'คุณแน่ใจหรือไม่?', text: 'คุณต้องการลบคิวส่งของนี้ออกจากระบบ', icon: 'warning', showCancelButton: true, confirmButtonText: 'ใช่, ลบเลย!', cancelButtonText: 'ยกเลิก' }).then(result => {
        if (result.isConfirmed) window.location.href = `/admin/routes/delete/${id}`;
      });
    }

    function clearFilters() {
      clearFilterState()
      window.location.href='/admin/routes'
    }
  </script>
  <%-include('includes/footer')%>
</body>
</html>
