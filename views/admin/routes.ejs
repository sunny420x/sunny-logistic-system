<!doctype html>
<html lang="th">
<head>
  <title>คิวส่งของ | <%=settings.company_name%></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <%-include('includes/head')%>
  <style>
    #map {
      width: 100%;
      height: 50vh;
      z-index: 1;
      overflow: hidden;
    }

    #poiListWrapper {
      height: 50vh;
      overflow: auto;
      border-radius: 0;
    }
  </style>
</head>
<body>
  <%-include('includes/topbar')%>
  <%-include('includes/desktop-sidebar')%>
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">คิวส่งของ 
        <button class="btn btn-outline-primary" type="button" onclick="window.location.href='/admin/routes/calendar'"><i class="bi bi-calendar"></i> แสดงปฏิทิน</button>
        <button class="btn btn-outline-primary" type="button" id="getTodayRouteBtn"><i class="bi bi-calendar"></i> แสดงคิววันนี้</button>
        <button class="btn btn-outline-primary" type="button" onclick="window.location.href='/admin/routes/add'"><i class="bi bi-calendar-plus"></i> เพิ่มคิวส่งของ</button>
        <button id="togglePoiButton" class="btn btn-outline-success" type="button"><i class="bi bi-people"></i> <span id="togglePoiText"></span></button>
      </h2>
      <div class="d-lg-flex flex-md-row gap-2 mb-4">
        <form action="" method="get" class="d-flex gap-2">
          <div class="d-lg-flex w-100 gap-2">
            <div class="input-group" style="min-width: 300px;">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input class="form-control bg-light" name="q" id="topbarSearch" type="search" placeholder="ค้นหา...">
            </div>
            <input type="date" class="form-control w-100" name="date" id="dateSearch" value="" style="min-width: 200px;">
            <select name="status" id="statusSearch" class="form-select w-100" style="min-width: 200px;">
              <option value="">เลือกสถานะ</option>
              <option value="0">มอบหมายแล้ว</option>
              <option value="1">ส่งแล้ว</option>
            </select>
            <button class="btn btn-primary w-100 mt-2 mt-lg-0" id="filterBtn"><i class="bi bi-filter"></i> กรองวันที่</button>
          </div>
        </form>
        <div class="d-lg-block mt-2 mt-lg-0">
          <button class="btn btn-secondary w-100" id="clearFilterBtn" onclick="clearFilters()"><i class="bi bi-x"></i> ล้างตัวกรอง</button>
        </div>
        <script>
          function getSearchQuery() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('q') ?? "";
          }
          
          function getStatusQuery() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('status') ?? "";
          }
          
          function getDateQuery() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('date') ?? "";
          }
          
          document.getElementById('topbarSearch').value = getSearchQuery() ?? ''
          document.getElementById('dateSearch').value = getDateQuery() ?? ''
          document.getElementById('statusSearch').value = getStatusQuery() ?? ''
        </script>
      </div>
      <div class="row g-0 gap-0">
        <div class="col-lg" id="map"></div>
        <div class="col-lg-4 table-responsive" id="poiListWrapper">
          <table class="table">
            <thead>
              <th colspan="2">ลูกค้า</th>
              <th>โทรศัพท์</th>
            </thead>
            <tbody id="poiList"></tbody>
          </table>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table text-center">
          <thead>
            <th>#</th>
            <th>วันที่</th>
            <th>รหัสลูกค้า</th>
            <th>ชื่อลูกค้า</th>
            <th>สถานะ</th>
            <th>ทะเบียนรถ</th>
            <th>พนักงานปฏิบัติการ</th>
            <th>พิกัดที่อยู่</th>
            <th>น้ำหนัก</th>
            <th>เสร็จสิ้นเมื่อเวลา</th>
            <th>จัดการ</th>
          </thead>
          <tbody>
            <% routes.forEach(row => { %>
            <tr>
              <td><%=row.id%></td>
              <td><%=moment(row.date).format("DD/MM/YY")%></td>
              <td><%=row.customer_id%></td>
              <td><%=row.customer_name%></td>
              <td><%if(row.status) { %><span class="badge bg-success fw-normal">ส่งแล้ว</span><% } else { %><span class="badge bg-primary fw-normal">มอบหมายแล้ว</span><% } %></td>
              <td><a href="/admin/trucks/edit/<%=row.truck_id%>" class="badge bg-secondary fw-normal" style="text-decoration: none;"><%=row.license_plate%></a></td>
              <td><a href="/admin/users/edit/<%=row.driver_id%>" class="badge bg-secondary fw-normal" style="text-decoration: none;"><%=row.driver_full_name%></a></td>
              <td>📍 <a href="https://map.google.co.th/?q=<%=row.location.split(',')[1] %>,<%=row.location.split(',')[0] %>" class="text-decoration-none" target="_blank">Google Maps</a></td>
              <td><%=row.weight ?? 0%> กิโลกรัม</td>
              <td><%=row.finish_at ? moment(row.finish_at).format("DD/MM/YY HH:mm") : "-" %></td>
              <td>
                <button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/routes/edit/<%=row.id%>'"><i class="bi bi-pencil-square"></i> แก้ไข</button>
                <button class="btn btn-outline-danger btn-sm" onclick="
                Swal.fire({
                  title: 'คุณแน่ใจหรือไม่?',
                  text: 'คุณต้องการลบคิวส่งของนี้ออกจากระบบ',
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#3085d6',
                  cancelButtonColor: '#d33',
                  confirmButtonText: 'ใช่, ลบเลย!',
                  cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                  if (result.isConfirmed) {
                    window.location.href='/admin/routes/delete/<%=row.id%>'
                  }
                })
                "><i class="bi bi-trash3"></i> ลบ</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
  <script src="/js/admin/map.js"></script>
  <script>
    let search = getSearchQuery()
    let date = getDateQuery()
    let status = getStatusQuery()

    let display_poi = false;
    let poi_list = []
    document.getElementById('poiListWrapper').style.display = display_poi ? "block" : "none"

    async function toggleDisplayPOI() {
      display_poi = !display_poi
      document.getElementById('poiListWrapper').style.display = display_poi ? "block" : "none"
      initializePOI()
      if (display_poi) {
        poi_list = []
      }
      try {
        await updateMap('route')
      } catch (error) {
        console.error('toggleDisplayPOI error', error)
        const poiListElem = document.getElementById('poiList')
        if (poiListElem) {
          poiListElem.innerHTML = `<tr><td colspan="3">เกิดข้อผิดพลาดในการโหลด POI</td></tr>`
        }
      }
    }

    function initializePOI() {
      if(!display_poi) {
        document.getElementById('togglePoiText').textContent = "แสดง Point of Interest (POI)"
      } else {
        document.getElementById('togglePoiText').textContent = "ซ่อน Point of Interest (POI)"
        const poiListElem = document.getElementById('poiList')
        if (poiListElem) {
          poiListElem.innerHTML = `<tr><td colspan="3">กำลังโหลด Point of Interest...</td></tr>`
        }
      }
    }

    function renderPoiList() {
        const poiListElem = document.getElementById('poiList');
        if (!poiListElem) {
          console.error("[!] #poiList element not found!")
          return;
        }
        poiListElem.innerHTML = ""
        if (poi_list.length === 0) {
          poiListElem.innerHTML = `<tr><td colspan="3">ไม่มี Point of Interest</td></tr>`
          return;
        }
        let html = ''
        poi_list.forEach((poi) => {
          html += `
          <tr>
            <td>${poi.customer_id}</td>
            <td><a href="/admin/customers/edit/${poi.id}" target="_blank">${poi.customer_name}</a></td>
            <td>${formatPhoneNumber(poi.phone_number ?? "-")}</td>
          </tr>`
        })
        poiListElem.innerHTML = html
    }

    document.getElementById('togglePoiButton').addEventListener('click', async function() {
      await toggleDisplayPOI();
    });

    //โชว์คิวของวันนี้
    document.getElementById('getTodayRouteBtn').addEventListener('click', function() {
      document.getElementById('dateSearch').value = "<%=moment().format('YYYY-MM-DD')%>"
      document.getElementById('filterBtn').click()
    })

    initializeMap()
    initializePOI()
    updateMap('route')

    function clearFilters() {
      window.location.href='/admin/routes'
    }
  </script>
  <%-include('includes/footer')%>
</body>
</html>
