<!doctype html>
<html lang="th">
<head>
  <title>ประเภทการซ่อมบำรุง | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex">
                <h2 class="fw-bold mb-3">ประเภทการซ่อมบำรุง
                    <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/repair_type/add'"><i class="bi bi-file-earmark-plus"></i> เพิ่มประเภท</button>
                </h2>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>ประเภท</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody id="repairTypesTableBody"><tr><td colspan="2" class="text-muted text-center">กำลังโหลดข้อมูล...</td></tr></tbody>
        </table>
        <div id="repairTypesPagination" class="mt-3"></div>
    </main>
  </div>
    <script>
        const repairTypesTable = AdminServerPagination({
            resource: 'repair_types', tableBody: 'repairTypesTableBody', pagination: 'repairTypesPagination', colspan: 2,
            getFilters: () => ({}),
            renderRow: row => `<tr><td>${row.name}</td><td><button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/repair_type/edit/${row.id}'"><i class="bi bi-pencil-square"></i> แก้ไข</button> <button class="btn btn-outline-danger btn-sm" onclick="window.location.href='/admin/repair_type/delete/${row.id}'"><i class="bi bi-trash3"></i> ลบ</button></td></tr>`
        });
        repairTypesTable.load();
    </script>
  <%-include('includes/footer')%>
</body>
</html>
