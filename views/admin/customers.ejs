<!doctype html>
<html lang="th">
<head>
  <title>Customers</title>
  <%-include('includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <!-- Topbar -->
    <%-include('includes/topbar')%>

    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">👨🏻‍💼 ลูกค้าในระบบ <button class="btn btn-outline-primary" onclick="window.location.href='/admin/customers/add'">➕ เพิ่มลูกค้า</button></h2>
      <table class="table">
        <thead>
          <th style="width: 40px;" class="text-center">#</th>
          <th style="width: 80px;" class="text-center">รหัสลูกค้า</th>
          <th>ชื่อลูกค้า</th>
          <th style="width: 150px;" class="text-center">พิกัดที่อยู่</th>
          <th style="width: 200px;" class="text-center">จัดการ</th>
        </thead>
        <tbody>
          <% customers.forEach(row => { %>
          <tr>
            <td class="text-center"><%=row.id%></td>
            <td class="text-center"><span class="badge bg-secondary fs-6 fw-normal"><%=row.customer_id%></span></td>
            <td><%=row.customer_name%></td>
            <td class="text-center">📍 <a href="https://map.google.co.th/?q=<%=row.location.split(',')[1] %>,<%=row.location.split(',')[0] %>" target="_blank" class="text-decoration-none">Google Maps</a></td>
            <td class="text-center">
              <button class="btn btn-outline-primary" onclick="window.location.href='/admin/customers/edit/<%=row.id%>'">แก้ไข</button>
              <button class="btn btn-outline-danger" onclick="
              Swal.fire({
                title: 'คุณแน่ใจหรือไม่?',
                text: 'คุณต้องการลบลูกค้ารายนี้ออกจากระบบ',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'ใช่, ลบเลย!',
                cancelButtonText: 'ยกเลิก'
              }).then((result) => {
                if (result.isConfirmed) {
                  window.location.href='/admin/customers/delete/<%=row.id%>'
                }
              })
              ">ลบ</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>

  <%-include('includes/footer')%>
</body>
</html>
