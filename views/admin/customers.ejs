<!doctype html>
<html lang="th">
<head>
  <title>ลูกค้าในระบบ | <%=settings.company_name%></title>
  <%-include('includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 100%;
      height: 80vh;
      z-index: 1;
      overflow: hidden;
    }
    #customer_table_wrapper {
      max-height: calc(80vh - 45px);
      overflow: auto;
    }
    #mapWrapper {
      width: 45%;
    }
    #customersWrapper {
      width: 55%;
    }
    @media screen and (max-width: 1024px) {
      #map {
        width: 100%;
        height: 40vh;
      }
      #customer_table_wrapper {
        width: 100%;
      }
      #mapWrapper {
        width: 100%;
        overflow: hidden;
      }
      #customersWrapper {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">ลูกค้าในระบบ
        <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/customers/add'"><i class="bi bi-person-plus"></i> เพิ่มลูกค้า</button>
      </h2>
      <div class="d-lg-flex">
        <div id="mapWrapper">        
          <div id="map"></div>
        </div>
        <div class="px-2" id="customersWrapper">
          <div class="d-flex mb-2 gap-2">
            <form style="width: 50%;">
              <div class="input-group">
                  <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                  <input class="form-control bg-light" name="q" id="topbarSearch" type="search" placeholder="ค้นหา...">
              </div>
            </form>
            <select style="width: 30%;" class="form-select d-inline-block" onchange="window.location.href='/admin/customers?group_id=' + this.value">
              <option value="">ทั้งหมด</option>
              <% customer_groups.forEach(row => { %>
                <option value="<%=row.id%>" <%if(row.id == group_id) {%>selected<%}%>><%=row.name%></option>
              <% }) %>
            </select>
            <button style="width: 20%;" class="btn btn-secondary btn-sm" onclick="window.location.href='/admin/customers'"><i class="bi bi-x-circle"></i> ล้างตัวกรอง</button>
          </div>
          <script>
              document.getElementById('topbarSearch').value = getSearchQuery() ?? ''

              function getSearchQuery() {
                  const urlParams = new URLSearchParams(window.location.search);
                  return urlParams.get('q');
              }
          </script>
          <div class="table-responsive" id="customer_table_wrapper">
            <table class="table">
              <thead>
                <th style="width: 40px;" class="text-center">#</th>
                <th style="width: 150px;" class="text-center">รหัสลูกค้า</th>
                <th style="width: 250px;">ชื่อลูกค้า</th>
                <th style="width: 150px;">กลุ่มลูกค้า</th>
                <th style="width: 200px;" class="text-center">จัดการ</th>
              </thead>
              <tbody>
                <% customers.forEach(row => { %>
                <tr>
                  <td class="text-center"><%=row.id%></td>
                  <td class="text-center"><span class="badge bg-secondary fs-6 fw-normal"><%=row.customer_id%></span></td>
                  <td><%=row.customer_name%></td>
                  <td><a href="/admin/customers?group_id=<%=row.group_id%>" class="badge fw-normal" style="background: <%=row.color%>; color: white; text-decoration: none;"> <%=row.customer_group%> </a></td>
                  <td class="text-center">
                    <button class="btn btn-outline-success btn-sm" onclick="selectMark('<%=row.id%>', true)"><i class="bi bi-pin"></i></button>
                    <button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/customers/edit/<%=row.id%>'"><i class="bi bi-pencil-square"></i></button>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%-include('includes/footer')%>
  <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
  <script src="/js/admin/map.js"></script>
  <script>
    initializeMap();
    updateMap('customers');

    setInterval(() => {
        updateMap('customers');
    }, 15000);
  </script>
  <% if(customers.length == 1) { %>
    <script>
    setTimeout(() => {
      selectMark('<%=customers[0].id%>', false)
    }, 1000)
    </script>
  <% } %>
</body>
</html>
