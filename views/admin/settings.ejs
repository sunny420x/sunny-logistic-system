<!doctype html>
<html lang="th">
<head>
  <title>ตั้งค่าระบบ | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">ตั้งค่าระบบ</h2>
      <form action="" method="post">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <th>รายการ</th>
              <th>จัดการ</th>
            </thead>
            <tbody>
              <tr>
                <td>ชื่อบริษัท</td>
                <td><input type="text" name="company_name" class="form-control" value="<%=settings.company_name%>"></td>
              </tr>
              <tr>
                <td>URL รูปภาพ Logo</td>
                <td><input type="text" name="company_logo" class="form-control" value="<%=settings.company_logo%>"></td>
              </tr>
              <tr>
                <td>URL รูปภาพ Banner</td>
                <td><input type="text" name="company_banner" class="form-control" value="<%=settings.company_banner%>"></td>
              </tr>
              <tr>
                <td>โซนการทำงานของบริษัท</td>
                <td><input type="text" name="company_zone" class="form-control" value="<%=settings.zone%>"></td>
              </tr>
              <tr>
                <td colspan="2">
                  <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-floppy me-2"></i>บันทึกการเปลี่ยนแปลง</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </form>
      <h2 class="fw-bold mt-3">ประวัติการใช้งาน</h2>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>รายการ</th>
              <th>จัดการ</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>ลบประวัติการใช้งานที่เก่ากว่า</td>
              <td class="d-flex gap-2">
                  <input type="number" id="clearLogAmount" class="form-control" style="width: 200px;" value="20">
                  <button class="btn btn-outline-danger" onclick="
                  Swal.fire({
                    title: 'คุณแน่ใจหรือไม่?',
                    text: 'คุณกำลังจะลบข้อมูลประวัติการใช้งานเก่า จำนวน '+document.getElementById('clearLogAmount').value+' รายการออกจากระบบ',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'ใช่, ลบเลย!',
                    cancelButtonText: 'ยกเลิก'
                  }).then((result) => {
                    if (result.isConfirmed) {
                      window.location.href='/admin/clearLogs?limit='+document.getElementById('clearLogAmount').value
                    }
                  })
                "><i class="bi bi-trash me-2"></i>ลบประวัติการใช้งาน</button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <%-include('includes/footer')%>
</body>
</html>
