<!doctype html>
<html lang="th">
<head>
  <title>Logs | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-lg-flex gap-2">
        <h2 class="fw-bold mb-3">Logs</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <th style="width: 40px;">#</th>
            <th style="width: 100px;">Action</th>
            <th style="width: 200px;">Details</th>
            <th style="width: 200px;">จัดการ</th>
          </thead>
          <tbody>
            <% logs.forEach(row => { %>
            <tr>
              <td><%=row.id%></td>
              <td><%=row.action%></td>
              <td><%=row.details%></td>
              <td>
                <button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/logs/<%=row.id%>'"><i class="bi bi-pencil-square"></i> แก้ไข</button>
                <button class="btn btn-outline-danger btn-sm" onclick="
                Swal.fire({
                  title: 'คุณแน่ใจหรือไม่?',
                  text: 'คุณต้องการลบผู้ใช้งานรายนี้ออกจากระบบ',
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#3085d6',
                  cancelButtonColor: '#d33',
                  confirmButtonText: 'ใช่, ลบเลย!',
                  cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                  if (result.isConfirmed) {
                    window.location.href='/admin/logs/delete/<%=row.id%>'
                  }
                })
                "><i class="bi bi-trash3"></i> ลบ</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <%-include('includes/footer')%>
</body>
</html>
