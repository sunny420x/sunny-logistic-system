<!doctype html>
<html lang="th">
<head>
  <title>Logs | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-lg-flex gap-2">
        <h2 class="fw-bold mb-3">ประวัติการใช้งานระบบ</h2>
      </div>
      <div class="d-flex mb-3 gap-2">
        <label for="clearLogAmount" style="padding: 8px 5px 8px 0;">ลบประวัติการใช้งานที่เก่ากว่า</label><input type="number" id="clearLogAmount" class="form-control" style="width: 200px;" value="20">
        <button class="btn btn-outline-danger" onclick="
        Swal.fire({
          title: 'คุณแน่ใจหรือไม่?',
          text: 'คุณกำลังจะลบข้อมูลประวัติการใช้งานเก่า จำนวน '+document.getElementById('clearLogAmount').value+' รายการออกจากระบบ',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'ใช่, ลบเลย!',
          cancelButtonText: 'ยกเลิก'
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href='/clearLogs?limit='+document.getElementById('clearLogAmount').value
          }
        })
      "><i class="bi bi-trash me-2"></i>ลบประวัติการใช้งาน</button>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <th style="width: 40px;">#</th>
            <th style="width: 40px;">เมื่อ</th>
            <th style="width: 100px;">Action</th>
            <th style="width: 200px;">Details</th>
            <th style="width: 200px;">จัดการ</th>
          </thead>
          <tbody>
            <% logs.forEach(row => { %>
            <tr>
              <td><%=row.id%></td>
              <td><%if(row.created_at) {%><%=moment(row.created_at).format("DD/MM/YYYY HH:mm:ss") %><%} else {%>-<%}%></td>
              <td><%=row.action%></td>
              <td><%=row.details%></td>
              <td>
                <button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/logs/<%=row.id%>'"><i class="bi bi-eye"></i> ดูข้อมูล</button>
                <button class="btn btn-outline-danger btn-sm" onclick="
                Swal.fire({
                  title: 'คุณแน่ใจหรือไม่?',
                  text: 'คุณต้องการลบข้อมูลนี้ออกจากระบบใช่หรือไม่',
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#3085d6',
                  cancelButtonColor: '#d33',
                  confirmButtonText: 'ใช่, ลบเลย!',
                  cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                  if (result.isConfirmed) {
                    window.location.href='/admin/logs/delete/<%=row.id%>'
                  }
                })
                "><i class="bi bi-trash3"></i> ลบ</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <%-include('includes/footer')%>
</body>
</html>
