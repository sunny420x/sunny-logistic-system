<!doctype html>
<html lang="th">
<head>
  <title>ลูกค้าในระบบ | <%=settings.company_name%></title>
  <%-include('includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 80%;
      height: 60vh;
      z-index: 1;
      overflow: hidden;
    }
    #customer_groups {
      width: 20%;
      max-height: 60vh;
      overflow: auto;
    }
    .color_example {
      width: max-content;
      margin: 0 auto;
      padding: 10px;
      color: #fff;
    }
  </style>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <h2 class="fw-bold mb-3">กลุ่มลูกค้าในระบบ 
        <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/customer_groups/add'"><i class="bi bi-person-plus"></i> เพิ่มกลุ่มลูกค้า</button>
      </h2>
      <div class="d-flex my-3 gap-2">
        <form style="width: 100%;">
          <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
              <input class="form-control bg-light" name="q" id="topbarSearch" type="search" placeholder="ค้นหา...">
          </div>
        </form>
      </div>
      <script>
          document.getElementById('topbarSearch').value = getSearchQuery() ?? ''

          function getSearchQuery() {
              const urlParams = new URLSearchParams(window.location.search);
              return urlParams.get('q');
          }
      </script>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <th style="width: 40px;" class="text-center">#</th>
            <th style="width: 100px;" class="text-center">สี</th>
            <th style="width: 150px;">ชื่อกลุ่ม</th>
            <th style="width: 300px;" class="text-center">จัดการ</th>
          </thead>
          <tbody>
            <% customer_groups.forEach(row => { %>
            <tr>
              <td class="text-center"><%=row.id%></td>
              <td><div class="color_example"><%=row.color%></div></td>
              <td><%=row.name%></td>
              <td class="text-center">
                <button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/customer_groups/edit/<%=row.id%>'"><i class="bi bi-pencil-square"></i> แก้ไข</button>
                <button class="btn btn-outline-danger btn-sm" onclick="
                Swal.fire({
                  title: 'คุณแน่ใจหรือไม่?',
                  text: 'คุณต้องการลบลูกค้ารายนี้ออกจากระบบ',
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#3085d6',
                  cancelButtonColor: '#d33',
                  confirmButtonText: 'ใช่, ลบเลย!',
                  cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                  if (result.isConfirmed) {
                    window.location.href='/admin/customer_groups/delete/<%=row.id%>'
                  }
                })
                "><i class="bi bi-trash3"></i>ลบ</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
  <script>
    document.querySelectorAll('.color_example').forEach(element => {
      element.style.background = element.innerHTML;
    });
  </script>

  <%-include('includes/footer')%>
</body>
</html>
