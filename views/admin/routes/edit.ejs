<!doctype html>
<html lang="th">
<head>
  <title>จัดการคิวส่งของ</title>
  <%-include('../includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <!-- Topbar -->
    <%-include('../includes/topbar')%>

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-3">แก้ไขข้อมูลลูกค้าในระบบ</h2>
          <form action="" method="post" style="width: 500px;">
            <div class="form-group mb-3">
                <label for="customer_id">ลูกค้า: </label>
                <select name="customer_id" class="form-select" required>
                  <% customers.forEach(customer => { %>
                    <option value="<%=customer.id%>" <% if(route.customer_id == customer.customer_id) {%>selected<%}%> ><%=customer.customer_name%></option>
                  <% }) %>
                </select>
            </div>
            <div class="form-group mb-3">
                <label for="customer_id">รถที่ใช้ส่งสินค้า: </label>
                <select name="truck_id" class="form-select" required>
                  <% trucks.forEach(truck => { %>
                    <option value="<%=truck.id%>" <% if(route.truck_id == truck.id) {%>selected<%}%>><%=truck.license_plate%></option>
                  <% }) %>
                </select>
            </div>
            <div class="form-group mb-3">
                <label for="driver_id">พนักงานปฏิบัติการ (คนขับรถ): </label>
                <select name="driver_id" class="form-select" required>
                  <% drivers.forEach(driver => { %>
                    <option value="<%=driver.id%>" <% if(route.driver_id == driver.id) {%>selected<%}%>><%=driver.full_name%></option>
                  <% }) %>
                </select>
            </div>
            <div class="form-group mb-3">                
                <label for="location">วันที่: </label>
                <input type="date" name="date" class="form-control" value="<%=moment(route.date).format('YYYY-MM-DD')%>" required>
            </div>
            <div class="form-group mb-3">                
                <label for="location">น้ำหนักบรรทุก: </label>
                <input type="number" name="weight" class="form-control" value="<%=route.weight ?? 0%>" required>
            </div>

            <input type="submit" value="บันทึกการเปลี่ยนแปลง" class="btn btn-primary">
          </form>
        </div>
      </div>

      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
