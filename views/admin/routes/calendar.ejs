<!doctype html>
<html lang="th">
<head>
    <title>ปฏิทินการส่งสินค้า | <%=settings.company_name%></title>
    <%-include('../includes/head')%>
    <link
    href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css"
    rel="stylesheet"
    />
    <style>
    #routes-calendar {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
    }

    .route-event {
        padding: 3px 5px;
        line-height: 1.4;
        overflow: hidden;
    }

    .route-assigned {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
    }

    .route-completed {
        background-color: #198754 !important;
        border-color: #198754 !important;
        color: #fff;
        transition: 0.2s ease-in-out;
    }

    .fc-list-event:hover {
        color: #111;
    }

    .fc-event {
        cursor: pointer;
    }

    .fc-daygrid-event {
        white-space: normal;
    }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">


    <main class="container-fluid p-3 p-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex">
                <h2 class="fw-bold mb-3">ปฏิทินการส่งสินค้า
                </h2>
            </div>
            <form action="" method="get" class="d-flex gap-2">
                <div class="d-flex gap-2">
                    <input type="date" class="form-control" name="date" id="dateSearch" value="<% if(locals.date) {%><%=date%><%} else {%><%=moment().format('YYYY-MM-DD')%><%}%>">
                    <button class="btn btn-outline-primary" style="width: 200px;"><i class="bi bi-filter"></i> กรองวันที่</button>
                </div>
            </form>
            <script>
                document.getElementById('dateSearch').value = getSearchQuery() ?? ''

                function getSearchQuery() {
                    const urlParams = new URLSearchParams(window.location.search);
                    return urlParams.get('date');
                }
            </script>
        </div>
        <div id="routes-calendar"></div>
        <script>
            document.addEventListener('DOMContentLoaded', function () {

            const calendarEl = document.getElementById('routes-calendar');

            const events = [
                <% routes.forEach(row => { %>
                {
                id: '<%= row.id %>',
                title: '<%= row.customer_name %>',

                start: '<%= moment(row.date).format("YYYY-MM-DD") %>',

                <% if (row.finish_at) { %>
                end: '<%= moment(row.finish_at).format("YYYY-MM-DDTHH:mm:ss") %>',
                <% } %>

                extendedProps: {
                    customerId: '<%= row.customer_id %>',
                    customerName: '<%= row.customer_name %>',
                    status: <%= row.status ? 'true' : 'false' %>,
                    truckId: '<%= row.truck_id %>',
                    licensePlate: '<%= row.license_plate %>',
                    driverId: '<%= row.driver_id %>',
                    driverName: '<%= row.driver_full_name %>',
                    location: '<%= row.location %>',
                    weight: '<%= row.weight ?? 0 %>',
                    finishAt: '<%= row.finish_at ? moment(row.finish_at).format("DD/MM/YY HH:mm") : "-" %>'
                }
                },
                <% }) %>
            ];

            const calendar = new FullCalendar.Calendar(calendarEl, {

                initialView: 'dayGridMonth',

                locale: 'th',

                height: 'auto',

                headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
                },

                buttonText: {
                today: 'วันนี้',
                month: 'เดือน',
                week: 'สัปดาห์',
                list: 'รายการ'
                },

                events: events,

                eventClassNames: function(info) {

                if (info.event.extendedProps.status) {
                    return ['route-completed'];
                }

                return ['route-assigned'];
                },

                eventContent: function(info) {

                const props = info.event.extendedProps;

                return {
                    html: `
                    <div class="route-event">

                        <div class="fw-bold">
                        ${props.customerName}
                        </div>

                        <div class="small">
                        🚚 ${props.licensePlate}
                        </div>

                        <div class="small">
                        👤 ${props.driverName}
                        </div>

                    </div>
                    `
                };
                },

                eventClick: function(info) {

                    const event = info.event;
                    const props = event.extendedProps;

                    const [lon, lat] = props.location.split(',');

                    const mapUrl =
                        `https://map.google.co.th/?q=${lat},${lon}`;

                    Swal.fire({

                        title: props.customerName,

                        html: `
                        <div class="text-start">

                            <div class="mb-2">
                            <strong>รหัสลูกค้า:</strong>
                            ${props.customerId}
                            </div>

                            <div class="mb-2">
                            <strong>สถานะ:</strong>
                            ${
                                props.status
                                ? '<span class="badge bg-success">ส่งแล้ว</span>'
                                : '<span class="badge bg-primary">มอบหมายแล้ว</span>'
                            }
                            </div>

                            <div class="mb-2">
                            <strong>ทะเบียนรถ:</strong>
                            ${props.licensePlate}
                            </div>

                            <div class="mb-2">
                            <strong>พนักงานปฏิบัติการ:</strong>
                            ${props.driverName}
                            </div>

                            <div class="mb-2">
                            <strong>น้ำหนัก:</strong>
                            ${props.weight} กิโลกรัม
                            </div>

                            <div class="mb-2">
                            <strong>เสร็จสิ้นเมื่อ:</strong>
                            ${props.finishAt}
                            </div>

                            <div class="mb-2">
                            <strong>พิกัด:</strong>
                            ${props.location}
                            </div>

                            <div class="mt-3">
                            <a
                                href="${mapUrl}"
                                target="_blank"
                                class="btn btn-outline-secondary btn-sm"
                            >
                                📍 Google Maps
                            </a>
                            </div>

                        </div>
                        `,

                        showCancelButton: true,

                        confirmButtonText:
                        '<i class="bi bi-pencil-square"></i> แก้ไข',

                        cancelButtonText: 'ปิด',

                        confirmButtonColor: '#0d6efd'

                    }).then((result) => {

                        if (result.isConfirmed) {

                        window.location.href =
                            '/admin/routes/edit/' + event.id;

                        }

                    });

                    }

                });

                calendar.render();

            });
    </script>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment-timezone@0.5.37/builds/moment-timezone-with-data.js"></script>
  </div>
  <%-include('../../includes/footer')%>
</body>
</html>
