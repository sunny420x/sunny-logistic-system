<!doctype html>
<html lang="th">
<head>
  <title>เพิ่มคิวส่งของ | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <style>
    #map {
      width: 100%;
      height: 85vh;
      z-index: 1;
      border-radius: 20px;
      overflow: hidden;
    }
    .route-info {
      width: 700px;
      height: 85vh;
      overflow: auto;
    }
    @media screen and (max-width: 1024px) {
      #map {
        height: 50vh;
      }
      .route-info {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="mb-4">
        <div>
          <div class="d-lg-flex d-block">
            <div id="map"></div>
            <div class="route-info p-4 py-lg-0">
              <h2 class="fw-bold mb-3">เพิ่มคิวส่งของ</h2>
              <form action="" method="post">
                <div class="form-group mb-3">
                  <label for="customerSelect" class="form-label">เลือกลูกค้า:</label>
                  <select id="customerSelect" name="customer_id" class="form-select" required>
                  </select>
                </div>
                <script>
                  function loadCustomers() {
                    fetch('/api/getCustomers')
                      .then(res => {
                        if (res.status === 401) {
                          window.location.href = '/login';
                          return;
                        }
                        if (!res.ok) throw new Error('Failed to fetch customers');
                        return res.json();
                      })
                      .then(customers => {
                        const selectEl = $('#customerSelect');

                        // 1. แปลงข้อมูลให้อยู่ในรูปแบบที่ Select2 ต้องการ { id, text }
                        const data = customers.map(c => ({
                          id: c.id,
                          text: c.customer_name
                        }));

                        // 3. Initialize Select2
                        selectEl.select2({
                          theme: 'bootstrap-5',
                          data: data,
                          allowClear: true,
                          width: '100%'
                        });
                      })
                      .catch(err => console.error('Error fetching customers:', err));
                  }

                  document.addEventListener('DOMContentLoaded', () => {
                    loadCustomers();

                    $('#customerSelect').on('select2:select', function (e) {
                      const selectedValue = e.params.data.id;
                      if (typeof selectMark === 'function') {
                        selectMark(selectedValue, false);
                      }
                    });
                  });
                </script>
                <div class="form-group mb-3">
                    <label for="customer_id">รถที่ใช้ส่งสินค้า: </label>
                    <select name="truck_id" class="form-select" required>
                      <% trucks.forEach(truck => { %>
                        <option value="<%=truck.id%>"><%=truck.license_plate%></option>
                      <% }) %>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label for="driver_id">พนักงานปฏิบัติการ (คนขับรถ): </label>
                    <select name="driver_id" class="form-select" required>
                      <% drivers.forEach(driver => { %>
                        <option value="<%=driver.id%>"><%=driver.full_name%></option>
                      <% }) %>
                    </select>
                </div>
                <div class="form-group mb-3">                
                    <label for="temporary_location">ตำแหน่งชั่วคราว (กรณีส่งนอกพิกัดเดิมของลูกค้า): </label>
                    <input type="text" name="temporary_location" maxlength="100" class="form-control" onblur="validateTempLocation()">
                </div>
                <div class="form-group mb-3">                
                    <label for="date">วันที่: </label>
                    <input type="date" name="date" class="form-control" value="<%=moment().format('YYYY-MM-DD')%>" required>
                </div>
                <div class="form-group mb-3">                
                    <label for="time">เวลา: </label>
                    <input type="time" name="time_start" class="form-control" value="<%=moment().format('HH:mm:ss')%>" step="1" required>
                </div>
                <div class="form-group mb-3">                
                    <label for="location">น้ำหนักบรรทุก: </label>
                    <input type="number" name="weight" class="form-control" value="0" required>
                </div>
                <div class="form-group mb-3">                
                    <label for="driver_note">หมายเหตุสำหรับคนขับ: </label>
                    <textarea name="driver_note" maxlength="200" placeholder="เช่น จุดวางของ เก็บเงินปลายทาง หรือนำภาชนะเดิมกลับ" class="form-control" style="height: 120px;"></textarea>
                </div>
                <div class="form-group mb-3">                
                    <label for="location_note">หมายเหตุสถานที่: </label>
                    <textarea name="location_note" maxlength="200" placeholder="เช่น ตำแหน่งของจุดรับของเพิ่มเติม เลขที่อาคาร เลขที่บ้าน" class="form-control" style="height: 120px;"></textarea>
                </div>
                <input type="submit" value="เพิ่มคิวส่งของ" class="btn btn-primary w-100">
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
  <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
  <script src="/js/admin/map.js"></script>
  <script>
    initializeMap();
    updateMap('customers');
  </script>
</body>
</html>
