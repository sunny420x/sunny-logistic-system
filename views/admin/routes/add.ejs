<!doctype html>
<html lang="th">
<head>
  <title>เพิ่มคิวส่งของ | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 100%;
      height: 80vh;
      z-index: 1;
      border-radius: 20px;
      overflow: hidden;
    }
    @media screen and (max-width: 1024px) {
      #map {
        height: 50vh;
      }
    }
  </style>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="mb-4">
        <div>
          <h2 class="fw-bold mb-3">เพิ่มคิวส่งของ</h2>
          <div class="d-lg-flex d-block">
            <div id="map"></div>
            <div class="p-4 py-lg-0">
              <form action="" method="post">
                <div class="form-group mb-3">
                    <label for="customer_id">ลูกค้า: </label>
                    <select name="customer_id" class="form-select" onchange="selectMark(this.value)" required>
                      <% customers.forEach(customer => { %>
                        <option value="<%=customer.id%>"><%=customer.customer_name%></option>
                      <% }) %>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label for="customer_id">รถที่ใช้ส่งสินค้า: </label>
                    <select name="truck_id" class="form-select" required>
                      <% trucks.forEach(truck => { %>
                        <option value="<%=truck.id%>"><%=truck.license_plate%></option>
                      <% }) %>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label for="driver_id">พนักงานปฏิบัติการ (คนขับรถ): </label>
                    <select name="driver_id" class="form-select" required>
                      <% drivers.forEach(driver => { %>
                        <option value="<%=driver.id%>"><%=driver.full_name%></option>
                      <% }) %>
                    </select>
                </div>
                <div class="form-group mb-3">                
                    <label for="date">วันที่: </label>
                    <input type="date" name="date" class="form-control" value="<%=moment().format('YYYY-MM-DD')%>" required>
                </div>
                <div class="form-group mb-3">                
                    <label for="time">เวลา: </label>
                    <input type="time" name="time_start" class="form-control" value="<%=moment().format('HH:mm:ss')%>" required>
                </div>
                <div class="form-group mb-3">                
                    <label for="location">น้ำหนักบรรทุก: </label>
                    <input type="number" name="weight" class="form-control" required>
                </div>
                <input type="submit" value="เพิ่มลูกค้า" class="btn btn-primary w-100">
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
  <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
  <script src="/js/admin/map.js"></script>
  <script>
    initializeMap();
    updateMap('customers');
  </script>
</body>
</html>
