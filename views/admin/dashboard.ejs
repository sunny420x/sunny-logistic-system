<!doctype html>
<html lang="th">
<head>
  <title>Dashboard | <%=settings.company_name%></title>
  <%-include('includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 60%;
      height: 60vh;
      z-index: 1;
      overflow: hidden;
    }
    #ongoingDrivers {
      width: 40%;
      height: 60vh;
      overflow: auto;
      background: #fff;
    }

    @media screen and (max-width: 1024px) {
      #map {
        width: 100%;
      }
      #ongoingDrivers {
        width: 100%;

        table {
          width: 100%;
        }
      }
    }
  </style>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-1">📋 ภาพรวมระบบ</h2>
          <p class="text-secondary mb-0">
            ภาพรวมข้อมูลการส่งสินค้าวันนี้ จำนวนลูกค้า และผู้ใช้งานในระบบ
          </p>
        </div>
      </div>

      <!-- Container -->
      <section class="row g-3 g-xl-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">สินค้าที่ต้องส่ง</div>
                <h3 class="fw-bold mb-2"><%=all_package.count%> ชิ้น</h3>
                <small class="text-secondary">วันที่ <% if(locals.date) {%><%=date%><%} else {%><%=moment().format('DD/MM/YYYY')%><%}%></small>
              </div>
              <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-boxes"></i></div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">ส่งสินค้าแล้ว</div>
                <h3 class="fw-bold mb-2"><%=delivered.count%> ชิ้น</h3>
                <small class="text-secondary">วันที่ <% if(locals.date) {%><%=date%><%} else {%><%=moment().format('DD/MM/YYYY')%><%}%></small>
              </div>
              <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-boxes"></i></div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">จำนวนลูกค้าในระบบ</div>
                <h3 class="fw-bold mb-2"><%=customers.count%> คน</h3>
                <small class="text-secondary">วันที่ <%=moment().format("DD/MM/YYYY")%></small>
              </div>
              <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">จำนวนผู้ใช้งานระบบ</div>
                <h3 class="fw-bold mb-2"><%=users.count%> คน</h3>
                <small class="text-secondary">วันที่ <%=moment().format("DD/MM/YYYY")%></small>
              </div>
              <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-people"></i></div>
            </div>
          </div>
        </div>
      </section>
      <div class="d-lg-flex">
        <div id="map"></div>
        <div id="ongoingDrivers">
          <a href="/admin/routes?date=<%=moment().format('YYYY-MM-DD')%>" class="btn btn-primary w-100 rounded-0">คิวส่งของทั้งหมดของวันนี้</a>
          <table class="table">
            <thead>
              <th>ลูกค้า</th>
              <th>พนักงานขับรถ</th>
              <th>ทะเบียนรถ</th>
            </thead>
            <tbody>
              <% if(ongoing_drivers.data.length > 0) { 
                let current_driver = ""  
              %>
              <% ongoing_drivers.data.forEach(driver => { 
              %>
                <tr>
                  <td>
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="<%=driver.color%>" class="bi bi-geo-alt-fill" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/></svg> 
                    <a href="/admin/routes/edit/<%= driver.id %>">
                      <%= driver.customer_name %>
                    </a>
                  </td>
                  <% if(driver.full_name != current_driver) { %>
                    <td><%= driver.full_name %></td>
                    <td><%= driver.license_plate %></td>
                  <%
                      current_driver = driver.full_name
                    } else {
                  %>
                    <td></td>
                    <td></td>
                  <% } %>
                </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
      <script src="/js/admin/map.js"></script>
      <script>
        initializeMap(14);
        updateMap('drivers');

        setInterval(() => {
            updateMap('drivers');
        }, 15000);
      </script>
    </main>
  </div>
  <%-include('includes/footer')%>
</body>
</html>
