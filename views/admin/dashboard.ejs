<!doctype html>
<html lang="th">
<head>
  <title>Admin Dashboard</title>
  <%-include('includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 100%;
      height: 60vh;
      z-index: 1;
      border-radius: 20px;
      overflow: hidden;
    }
  </style>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <!-- Topbar -->
    <%-include('includes/topbar')%>

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-1">📋 ภาพรวมระบบ</h2>
          <p class="text-secondary mb-0">
            ภาพรวมข้อมูลการส่งสินค้า
          </p>
        </div>
        <div class="d-flex gap-2">
            <input type="date" class="form-control" value="<% if(locals.date) {%><%=date%><%} else {%><%=moment().format('YYYY-MM-DD')%><%}%>">
            <button class="btn btn-outline-primary" style="width: 150px;">กรองวันที่</button>
        </div>
      </div>

      <!-- Container -->
      <section class="row g-3 g-xl-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">สินค้าที่ต้องส่ง</div>
                <h3 class="fw-bold mb-2"><%=all_package.count%> ชิ้น</h3>
                <small class="text-secondary">วันที่ <% if(locals.date) {%><%=date%><%} else {%><%=moment().format('DD/MM/YYYY')%><%}%></small>
              </div>
              <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-boxes"></i></div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">ส่งสินค้าแล้ว</div>
                <h3 class="fw-bold mb-2"><%=delivered.count%> ชิ้น</h3>
                <small class="text-secondary">วันที่ <% if(locals.date) {%><%=date%><%} else {%><%=moment().format('DD/MM/YYYY')%><%}%></small>
              </div>
              <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-boxes"></i></div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">จำนวนลูกค้าในระบบ</div>
                <h3 class="fw-bold mb-2"><%=customers.count%> คน</h3>
                <small class="text-secondary">วันที่ <%=moment().format("DD/MM/YYYY")%></small>
              </div>
              <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card dashboard-card h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
              <div>
                <div class="text-secondary mb-2">จำนวนผู้ใช้งานระบบ</div>
                <h3 class="fw-bold mb-2"><%=users.count%> คน</h3>
                <small class="text-secondary">วันที่ <%=moment().format("DD/MM/YYYY")%></small>
              </div>
              <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-people"></i></div>
            </div>
          </div>
        </div>
      </section>
      <div id="map"></div>
      <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
      <script>
        let map = null
        let vectorSource = null;

        function initializeMap() {
            vectorSource = new ol.source.Vector();
            const vectorLayer = new ol.layer.Vector({ source: vectorSource });

            map = new ol.Map({
                target: 'map',
                layers: [
                    new ol.layer.Tile({ source: new ol.source.OSM() }),
                    vectorLayer
                ],
                view: new ol.View({ 
                    center: ol.proj.fromLonLat([98.9817, 18.7883]), 
                    zoom: 14 
                })
            });
        }

        async function updateTruckLocations() {
            try {
                const response = await fetch("/api/driver/getAllTruckLocation");

                if (!response.ok) {
                    throw new Error("ดึงข้อมูลจากหลังบ้านไม่สำเร็จ");
                }

                const data = await response.json();

                // เคลียร์เฉพาะ Marker เก่าออกจาก VectorSource (ไม่กระทบตัวแผนที่)
                vectorSource.clear();

                // วนลูปสร้าง Marker ใหม่
                data.locations.forEach(truck => {
                    const marker = new ol.Feature({ 
                        geometry: new ol.geom.Point(ol.proj.fromLonLat([
                            parseFloat(truck.position_longitude),
                            parseFloat(truck.position_latitude)
                        ])) 
                    });

                    marker.setStyle(new ol.style.Style({
                        image: new ol.style.Circle({ 
                            radius: 8, 
                            fill: new ol.style.Fill({ color: '#0000FF' }), 
                            stroke: new ol.style.Stroke({ color: '#FFFFFF', width: 2 }) 
                        }),
                        text: new ol.style.Text({
                            text: `${truck.license_plate} - คนขับ ${truck.full_name}`,
                            font: 'bold 13px Kanit',
                            offsetY: -15,
                            fill: new ol.style.Fill({ color: '#000000' }),
                            stroke: new ol.style.Stroke({ color: '#FFFFFF', width: 3 })
                        })
                    }));

                    vectorSource.addFeature(marker);
                });

            } catch (error) {
                console.error("เกิดข้อผิดพลาดในการอัปเดตพิกัด:", error);
            }
        }

        initializeMap();

        updateTruckLocations();

        setInterval(() => {
            updateTruckLocations();
        }, 10000);
      </script>
    </main>
  </div>
  <%-include('includes/footer')%>
</body>
</html>
