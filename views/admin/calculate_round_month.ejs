<!doctype html>
<html lang="th">
<head>
    <title>คิดค่ารอบประจำเดือน | <%=settings.company_name%></title>
  <%-include('includes/head')%>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex">
                <h2 class="fw-bold">คิดเงินค่ารอบประจำเดือน</h2>
            </div>
            <div class="d-flex gap-2">
                <form action="" method="get" class="d-flex gap-2">
                    <div class="d-flex gap-2">
                        <input type="date" class="form-control" name="start_date" id="startDateSearch" value="<%=start_date%>">
                        <span class="align-self-center">ถึง</span>
                        <input type="date" class="form-control" name="end_date" id="endDateSearch" value="<%=end_date%>">
                        <button class="btn btn-outline-primary" style="width: 200px;"><i class="bi bi-filter"></i> กรอง</button>
                    </div>
                </form>
                <a href="/admin/calculate_round" class="btn btn-outline-secondary"><i class="bi bi-calendar-day"></i> ดูรายวัน</a>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>พนักงานขับรถ</th>
                    <th>จำนวนรอบ</th>
                    <th>ค่ารอบ</th>
                    <th>ค่ารอบรวม</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <% if(drivers_round.length === 0) { %>
                    <tr>
                            <td colspan="5" class="text-muted text-center">ไม่มีข้อมูลรอบในช่วงวันที่เลือก</td>
                    </tr>
                <% } %>
                <% 
                current_driver_full_name = "";
                drivers_round.forEach(row => { %>
                    <tr>
                        <td>
                        <% if(current_driver_full_name !== row.full_name) { %>
                            <%=row.full_name%>
                        <% current_driver_full_name = row.full_name;
                        } %>
                        </td>
                        <td><%=row.round_count%> รอบ</td>
                        <td><%=parseInt(row.round_cost).toLocaleString('us')%> บาท/รอบ</td>
                        <td><%= (parseInt(row.round_count) * parseInt(row.round_cost)).toLocaleString('us') %> บาท</td>
                        <td>
                            <button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/calculate_round_month/report/<%=row.driver_id%>?start_date=' + encodeURIComponent(document.getElementById('startDateSearch').value) + '&end_date=' + encodeURIComponent(document.getElementById('endDateSearch').value)"><i class="bi bi-file-earmark-text"></i> ออกรายงาน</button>
                        </td>
                    </tr>
                <% 
                }) %>
            </tbody>
        </table>
    </main>
  </div>
  <%-include('../includes/footer')%>
</body>
</html>
