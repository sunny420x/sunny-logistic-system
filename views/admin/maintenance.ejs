<!doctype html>
<html lang="th">
<head>
  <title>รายการบำรุงรักษารถ | <%=settings.company_name%></title>
  <%-include('includes/head')%>
  <style>
    #map {
      width: 100%;
      height: 70vh;
      z-index: 1;
      border-radius: 20px;
      overflow: hidden;
    }
  </style>
</head>
<body>
  <%-include('includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <main class="container-fluid p-3 p-lg-4">
    <%-include('includes/maintenance_alert')%>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex">
                <h2 class="fw-bold">รายการบำรุงรักษารถ<% if(locals.license_plate) { %>: <div class="badge bg-primary"><%=locals.license_plate%></div> <% } %></h2>
            </div>
            <form action="" method="get" class="d-flex gap-2">
                <div class="d-flex gap-2">
                    <input type="date" class="form-control" name="date" id="dateSearch" value="<% if(locals.date) {%><%=date%><%} else {%><%=moment().format('YYYY-MM-DD')%><%}%>">
                    <button class="btn btn-outline-primary" style="width: 200px;"><i class="bi bi-filter"></i> กรองวันที่</button>
                </div>
            </form>
            <script>
                document.getElementById('dateSearch').value = getSearchQuery() ?? ''

                function getSearchQuery() {
                    const urlParams = new URLSearchParams(window.location.search);
                    return urlParams.get('date');
                }
            </script>
        </div>
        <div class="d-flex">            
            <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/maintenances/add?id=<%=locals.id%>'"><i class="bi bi-file-earmark-plus"></i> เพิ่มข้อมูลบำรุงรักษา</button>
            <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/maintenances/types'"><i class="bi bi-gear"></i> จัดการประเภทการบำรุงรักษา</button>
            <button class="btn btn-outline-primary btn-sm ms-2" onclick="window.location.href='/admin/routine_check/<%=locals.id%>'"><i class="bi bi-check2-circle"></i> รายการตรวจเช็ครถประจำสัปดาห์</button>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <% if(!locals.license_plate) { %>
                        <th>ทะเบียนรถ</th>
                        <% } %>
                        <th>วันที่ตรวจเช็คล่าสุด</th>
                        <th>ผู้ตรวจเช็ค</th>
                        <th>ประเภทตรวจเช็ค</th>
                        <th>หมายเหตุ</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>
                <tbody id="maintenanceTableBody"><tr><td colspan="<%=locals.license_plate ? 5 : 6%>" class="text-muted text-center">กำลังโหลดข้อมูล...</td></tr></tbody>
            </table>
        </div>
        <div id="maintenancePagination" class="mt-3"></div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
        <script>
            const maintenanceShowsTruck = <%=locals.license_plate ? 'false' : 'true'%>;
            const maintenanceTable = AdminServerPagination({
                resource: 'maintenance', tableBody: 'maintenanceTableBody', pagination: 'maintenancePagination', colspan: <%=locals.license_plate ? 5 : 6%>,
                getFilters: () => ({ date: getSearchQuery(), truck_id: '<%=locals.id || ""%>' }),
                renderRow: row => `<tr>${maintenanceShowsTruck ? `<td>${row.license_plate || '-'}</td>` : ''}<td>${moment(row.created_at).format('DD/MM/YYYY HH:mm:ss')}</td><td>${row.full_name || '-'}</td><td>${row.maintenace_name || '-'}</td><td>${row.note || '-'}</td><td><button class="btn btn-outline-primary btn-sm" onclick="window.location.href='/admin/maintenances/edit/${row.id}'"><i class="bi bi-pencil-square"></i> แก้ไข</button> <button class="btn btn-outline-danger btn-sm" onclick="window.location.href='/admin/maintenances/delete/${row.id}'"><i class="bi bi-trash3"></i> ลบ</button></td></tr>`
            });
            maintenanceTable.load();
        </script>
  </div>
  <%-include('includes/footer')%>
</body>
</html>
