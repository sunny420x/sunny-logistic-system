<!doctype html>
<html lang="th">
<head>
  <title>ประวัติพิกัดรถขนส่ง | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v10.10.0/ol.css">
  <style>
    #map {
      width: 100%;
      height: 70vh;
      z-index: 1;
      overflow: hidden;
    }
  </style>
</head>
<body>
  <%-include('../includes/topbar')%>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">


    <main class="container-fluid p-3 p-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex">
                <h2 class="fw-bold mb-3">📍 ประวัติพิกัดรถขนส่ง</h2>
            </div>
            <form action="" method="get" class="d-flex gap-2">
                <div class="d-flex gap-2">
                    <input type="date" class="form-control" name="date" id="dateSearch" value="<% if(locals.date) {%><%=date%><%} else {%><%=moment().format('YYYY-MM-DD')%><%}%>">
                    <button class="btn btn-outline-primary" style="width: 200px;"><i class="bi bi-filter"></i> กรองวันที่</button>
                </div>
            </form>
            <script>
                document.getElementById('dateSearch').value = getSearchQuery() ?? ''

                function getSearchQuery() {
                    const urlParams = new URLSearchParams(window.location.search);
                    return urlParams.get('date');
                }
            </script>
        </div>
        <div id="map"></div>
        <div class="table-responsive mb-4">
            <table class="table">
                <thead class="table-light">
                    <tr>
                        <th>วันที่</th>
                        <th>ทะเบียนรถ</th>
                        <th>ระยะทางรวม</th>
                        <th>เวลาเดินทาง</th>
                        <th>ความเร็วเฉลี่ย</th>
                        <th>ความเร็วสูงสุด</th>
                    </tr>
                </thead>

                <tbody id="truckStatsTable">
                    <tr>
                        <td colspan="6" class="text-muted">
                            กำลังโหลดข้อมูล...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/ol@v10.10.0/dist/ol.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/moment-timezone@0.5.37/builds/moment-timezone-with-data.js"></script>
        <script>
            let map = null
            let vectorSource = null;
            let routeSource = null;

            function initializeMap() {
                vectorSource = new ol.source.Vector();
                routeSource = new ol.source.Vector();
                const routeLayer = new ol.layer.Vector({
                    source: routeSource,
                    style: new ol.style.Style({
                        stroke: new ol.style.Stroke({
                            color: '#0d6efd',
                            width: 4
                        })
                    })
                });
                const vectorLayer = new ol.layer.Vector({ source: vectorSource });

                map = new ol.Map({
                    target: 'map',
                    layers: [
                        new ol.layer.Tile({ source: new ol.source.OSM() }),
                        routeLayer,
                        vectorLayer
                    ],
                    view: new ol.View({ 
                        center: ol.proj.fromLonLat([98.9817, 18.7883]), 
                        zoom: 14 
                    })
                });
            }

            async function drawOsrmRoute(coordinates) {
                if (coordinates.length < 2) {
                    return;
                }

                const osrmCoordinates = [];
                const chunkSize = 50;

                for (let start = 0; start < coordinates.length - 1; start += chunkSize - 1) {
                    const chunk = coordinates.slice(start, start + chunkSize);
                    const coordsString = chunk
                        .map(([longitude, latitude]) => `${longitude},${latitude}`)
                        .join(';');
                    const routeUrl = `https://router.project-osrm.org/route/v1/driving/${coordsString}?overview=full&geometries=geojson`;
                    const response = await fetch(routeUrl);
                    if (!response.ok) {
                        throw new Error(`OSRM ตอบกลับด้วยสถานะ ${response.status}`);
                    }

                    const routeData = await response.json();
                    if (routeData.code !== 'Ok' || !routeData.routes?.[0]?.geometry?.coordinates) {
                        throw new Error('OSRM ไม่พบเส้นทางบนถนนสำหรับพิกัดชุดนี้');
                    }

                    const geometryCoordinates = routeData.routes[0].geometry.coordinates;
                    osrmCoordinates.push(
                        ...geometryCoordinates.slice(start === 0 ? 0 : 1)
                    );
                }

                routeSource.addFeature(new ol.Feature({
                    geometry: new ol.geom.LineString(
                        osrmCoordinates.map(coordinate => ol.proj.fromLonLat(coordinate))
                    )
                }));
            }

            function drawCustomerMarkers(locations) {
                const drawnCustomers = new Set();

                locations.forEach(truck => {
                    const customerKey = truck.customer_row_id ?? `${truck.customer_name}|${truck.location}`;
                    if (drawnCustomers.has(customerKey) || !truck.location) {
                        return;
                    }

                    const [longitude, latitude] = truck.location.split(',').map(Number);
                    if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
                        return;
                    }

                    drawnCustomers.add(customerKey);
                    const marker = new ol.Feature({
                        geometry: new ol.geom.Point(
                            ol.proj.fromLonLat([longitude, latitude])
                        )
                    });

                    marker.setStyle(new ol.style.Style({
                        image: new ol.style.Icon({ anchor: [0.5, 1], src: '/icons/marker-success.png', scale: 0.5 }),
                        text: new ol.style.Text({
                            text: `${truck.customer_name}`,
                            font: 'bold 13px Kanit',
                            offsetY: -35,
                            fill: new ol.style.Fill({ color: '#222222' }),
                            stroke: new ol.style.Stroke({ color: '#FFFFFF', width: 3 })
                        })
                    }));

                    vectorSource.addFeature(marker);
                });
            }

            async function updateTruckLocations() {
                try {
                    const response = await fetch("/api/driver/getTruckLocation/<%=truck_id%>/<%=date%>");

                    if (!response.ok) {
                        throw new Error("ดึงข้อมูลจากหลังบ้านไม่สำเร็จ");
                    }

                    const data = await response.json();

                    // เคลียร์เฉพาะ Marker เก่าออกจาก VectorSource (ไม่กระทบตัวแผนที่)
                    vectorSource.clear();
                    routeSource.clear();
                    const routeCoordinates = [];

                    drawCustomerMarkers(data.locations);

                    // วนลูปสร้าง Marker ใหม่
                    data.locations.forEach(truck => {
                        const latitude = parseFloat(truck.position_latitude);
                        const longitude = parseFloat(truck.position_longitude);
                        if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
                            return;
                        }

                        routeCoordinates.push([longitude, latitude]);
                        const marker = new ol.Feature({ 
                            geometry: new ol.geom.Point(
                                ol.proj.fromLonLat([longitude, latitude])
                            )
                        });

                        marker.setStyle(new ol.style.Style({
                            image: new ol.style.Icon({ anchor: [0.5, 1], src: '/icons/marker-pending.png', scale: 0.5 }),
                            text: new ol.style.Text({
                                text: `${moment(truck.created_at).format('YYYY-MM-DD HH:mm:ss')} - ${truck.driver_full_name}`,
                                font: 'bold 13px Kanit',
                                offsetY: -35,
                                fill: new ol.style.Fill({ color: '#000000' }),
                                stroke: new ol.style.Stroke({ color: '#FFFFFF', width: 3 })
                            })
                        }));

                        vectorSource.addFeature(marker);
                    });

                    if (routeCoordinates.length > 1) {
                        try {
                            await drawOsrmRoute(routeCoordinates);
                        } catch (error) {
                            console.error('ไม่สามารถสร้างเส้นทางด้วย OSRM:', error);
                        }
                    }
                    renderTruckStats(data);
                } catch (error) {
                    console.error("เกิดข้อผิดพลาดในการอัปเดตพิกัด:", error);
                }
            }

            initializeMap();

            updateTruckLocations();

            setInterval(() => {
                updateTruckLocations();
            }, 60000);

            function renderTruckStats(data) {
                const tbody = document.getElementById('truckStatsTable');
                if (!data || data.status !== 'success') {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-danger">
                                ไม่สามารถโหลดข้อมูลได้
                            </td>
                        </tr>
                    `;
                    return;
                }

                const locations = data.locations;
                const statsByDate = data.stats && data.stats.total_distance !== undefined
                    ? { [moment(locations[0]?.created_at).format('YYYY-MM-DD')]: data.stats }
                    : data.stats;

                if (!statsByDate || Object.keys(statsByDate).length === 0 || !locations || locations.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-muted">
                                ไม่มีข้อมูลการเดินทาง
                            </td>
                        </tr>
                    `;
                    return;
                }

                // ทะเบียนรถ
                const licensePlate =
                    locations[0].license_plate ?? '-';

                tbody.innerHTML = Object.entries(statsByDate).map(([date, stats]) => {
                    const totalMinutes = Math.floor(stats.total_time / (1000 * 60));
                    const hours = Math.floor(totalMinutes / 60);
                    const minutes = totalMinutes % 60;
                    const travelTime = `${hours > 0 ? `${hours} ชม. ` : ''}${minutes} นาที`;

                    return `
                    <tr>
                        <td>${moment(date).format('DD/MM/YYYY')}</td>

                        <td class="fw-bold">
                            ${licensePlate}
                        </td>

                        <td>
                            ${Number(stats.total_distance).toFixed(2)}
                            km
                        </td>

                        <td>
                            ${travelTime}
                        </td>

                        <td>
                            <span class="badge text-bg-primary">
                                ${Number(stats.average_speed).toFixed(2)}
                                km/h
                            </span>
                        </td>

                        <td>
                            <span class="badge text-bg-danger">
                                ${new Intl.NumberFormat('en-US').format(Number(stats.max_speed).toFixed(2))}
                                km/h
                            </span>
                        </td>
                    </tr>`;
                }).join('');
            }
        </script>
    </main>
  </div>
  <%-include('../includes/footer')%>
</body>
</html>
