<!doctype html>
<html lang="th">
<head>
  <title>Trucks</title>
  <%-include('../includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">
    <!-- Topbar -->
    <%-include('../includes/topbar')%>

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-3">แก้ไขข้อมูลรถในระบบ</h2>
          <form action="" method="post" style="width: 500px;">
            <div class="form-group mb-3">                
                <label for="license_plate">ทะเบียนรถ: </label>
                <input type="text" name="license_plate" class="form-control" value="<%=truck.license_plate%>" required>
            </div>
            <input type="submit" value="บันทึกการเปลี่ยนแปลง" class="btn btn-primary">
          </form>
        </div>
      </div>

      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
