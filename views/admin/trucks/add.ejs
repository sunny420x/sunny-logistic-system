<!doctype html>
<html lang="th">
<head>
  <title>เพิ่มรถในระบบ | <%=settings.company_name%></title>
  <%-include('../includes/head')%>
</head>
<body>

  <!-- Desktop Sidebar -->
  <%-include('../includes/desktop-sidebar')%>

  <!-- Mobile Sidebar -->
  <%-include('../includes/mobile-sidebar')%>

  <div class="main-wrapper">

    <main class="container-fluid p-3 p-lg-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-3">เพิ่มรถในระบบ</h2>
          <form action="" method="post" style="width: 800px;">
            <div class="form-group mb-3">
                <label for="license_plate">ทะเบียนรถ: </label>
                <input type="text" name="license_plate" class="form-control" required>
            </div>
            <div class="form-group mb-3">                
                <label for="brand">ยี่ห้อ: </label>
                <input type="text" name="brand" class="form-control" required>
            </div>
            <div class="form-group mb-3">                
                <label for="model">รุ่น: </label>
                <input type="text" name="model" class="form-control" required>
            </div>
            <div class="form-group mb-3">                
                <label for="cost_per_liter">ค่าใช้จ่ายต่อกิโลเมตร: </label>
                <input type="number" name="cost_per_km" class="form-control" required>
            </div>
            <input type="submit" value="เพิ่มรถ" class="btn btn-primary w-100">
          </form>
        </div>
      </div>

      <!-- Container -->
    </main>
  </div>

  <%-include('../includes/footer')%>
</body>
</html>
