    new Chart(document.getElementById('salesChart'), {
      type: 'line',
      data: {
        labels: ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.'],
        datasets: [{
          label: 'ยอดขาย',
          data: [185000, 220000, 198000, 275000, 310000, 365000, 428900],
          borderColor: '#0d6efd',
          backgroundColor: 'rgba(13,110,253,.10)',
          fill: true,
          tension: .4,
          borderWidth: 3,
          pointRadius: 4,
          pointBackgroundColor: '#fff',
          pointBorderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: {
            beginAtZero: true,
            ticks: {
              callback: value => '฿' + (value / 1000) + 'k'
            }
          }
        }
      }
    });

    new Chart(document.getElementById('channelChart'), {
      type: 'doughnut',
      data: {
        labels: ['เว็บไซต์', 'Shopee', 'Lazada', 'หน้าร้าน'],
